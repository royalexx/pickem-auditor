(function () {
  var BANNER_ID    = 'homepage-event-banner';
  var FEATURED_SEL = '.home_slide--featured-item';
  var VISIBLE_DISPLAY = 'flex';

  function isVisible(el) {
    var cs = getComputedStyle(el);
    return cs.visibility !== 'hidden'
        && cs.visibility !== 'collapse'
        && cs.display !== 'none';
  }

  function anyFeaturedVisible() {
    var items = document.querySelectorAll(FEATURED_SEL);
    for (var i = 0; i < items.length; i++) {
      if (isVisible(items[i])) return true;
    }
    return false;
  }

  function sync() {
    var banner = document.getElementById(BANNER_ID);
    if (!banner) return;
    var next = anyFeaturedVisible() ? 'none' : VISIBLE_DISPLAY;
    if (banner.style.display !== next) banner.style.display = next;
  }

  // rAF-throttled so bursts of mutations only cost one recalc per frame
  var queued = false;
  function schedule() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(function () { queued = false; sync(); });
  }

  function init() {
    sync();

    // Catches Webflow toggling classes / inline styles, and CMS items
    // being added or removed from the DOM.
    new MutationObserver(schedule).observe(document.body, {
      attributes: true,
      attributeFilter: ['style', 'class', 'hidden'],
      childList: true,
      subtree: true
    });

    // Safety net: pure-CSS changes (media queries, transitions, stylesheet
    // swaps) fire no mutations. Cheap poll, ~4x/sec.
    setInterval(schedule, 250);

    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
