<link rel="icon" href="https://nissanstadium.com/wp-content/uploads/cropped-Stadium-Favicon-192x192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="https://nissanstadium.com/wp-content/uploads/cropped-Stadium-Favicon-180x180.png" />
<meta name="msapplication-TileImage" content="https://nissanstadium.com/wp-content/uploads/cropped-Stadium-Favicon-270x270.png" />
<style id="wp-custom-css">
.event-space-card-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
}

.event-space-card-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    object-position: center;
    display: block;
}

/* Hosted Event fix
.event-space-card-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
}

.event-space-card-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    object-position: center;
    display: block;
}
End Hosted Event fix*/

.tribe-events .tribe-events-calendar-month__calendar-event-featured-image-wrapper,
.tribe-events .tribe-events-calendar-month__calendar-event-featured-image {
	display: none !important;
}

.fsDatePickerAdornment .sc-eqYatC, .fsTimePickerAdornment .sc-eqYatC {
	fill: white !important;
}

select:focus option {
	color: white !important;
}
</style>
</head>

