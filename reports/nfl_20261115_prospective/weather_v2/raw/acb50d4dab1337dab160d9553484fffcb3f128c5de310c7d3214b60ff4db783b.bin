<style>
.tribe-common .tribe-common-c-btn-border--alt:focus,
.tribe-common .tribe-common-c-btn-border--alt:hover {
    background-color: white !important;
}

.tribe-events .tribe-events-calendar-month__day-cell--mobile:focus, 
.tribe-events .tribe-events-calendar-month__day-cell--mobile:hover {
    background-color: hsl(0deg 6% 97% / 20%) !important;
}

.tribe-common--breakpoint-medium.tribe-events-pro .tribe-events-pro-photo__event {
    max-width: 33.33% !important;
}

.event-date-tag-block__datetime--multiday .event-date-tag-block__daynum {
    letter-spacing: 1px;
}

.tribe-events .tribe-events-calendar-month__calendar-event-featured-image-wrapper,
.tribe-events .tribe-events-calendar-month__calendar-event-featured-image {
	display: none !important;
}

/* event card block adjustments on homepage slider since changed from kadence query to advanced slider - JB 2/23 */
.wp-block-kadence-query:not(.featured-events) .event-link-buttons-block__registration.wp-block-button__link,
.wp-block-kadence-query:not(.featured-events) .event-link-buttons-block__registration.wp-block-button__link:visited,
.wp-block-kadence-slide .event-link-buttons-block__registration.wp-block-button__link,
.wp-block-kadence-slide .event-link-buttons-block__registration.wp-block-button__link:visited {
    width: auto !important;
    border-radius: 50px !important;
    padding: 5px 15px;
    text-transform: capitalize;
    letter-spacing: 0;
    font-weight: 500;
}
@media screen and (max-width: 600px) {
    .event-date-tag-block__datetime, .event-date-tag-block {
        width: 80px !important;
    }
}
@media screen and (max-width: 767px) {
    .event-date-tag-block__datetime, .event-date-tag-block {
        width: 90px !important;
    }
}
@media screen and (min-width: 768px) and (max-width: 1024px) {
    .event-date-tag-block__datetime, .event-date-tag-block {
        width: 90px !important;
    }
}
@media (min-width: 1025px) {
    .event-date-tag-block__datetime, .event-date-tag-block {
        width: 96px !important;
    }
}

.single-tribe_events .tribe-blocks-editor .tribe-events-schedule {
    background-color: rgba(255, 255, 255, 0.1) !important;
}

.policies-accordion__inner {
    padding: 0 0 1.5rem !important;
}

.LV_validation_message {
    display: none !important;
}

@media (max-width: 40em) {
    .fpGMPz:not(:last-child) {
        margin-right: 10px !important;
    }
}

@media (max-width: 767px) {
    h1 {
        font-size: clamp(2rem, 1.375rem + 1.6667vw, 3.375rem);
    }
}

/* DK Fixes */

/* City/State/Zip */
.dNXPet { 
    flex-basis: 20% !important;
}
.fpGMPz { 
    position: relative; 
    width: 100% !important; 
    flex-basis: calc(40% - 10px) !important; 
}
.kFIouZ label {
    display: flex;
}

/* Inputs */
.fsform-container form.fsForm select {
    padding: 6.4px 20px !important;
    height: 61px !important;
}

/* Date/Time picker icons */
.fsDatePickerAdornment .hHIBoN,
.fsTimePickerAdornment .sc-eqYatC{
    fill: #fff !important;
    color: #fff !important;
}
.fsDatePickerAdornment .hHIBoN:hover,
.fsTimePickerAdornment .sc-eqYatC:hover{
    fill: var(--global-palette-highlight) !important;
    color: var(--global-palette-highlight) !important;
}




</style>
<link rel='stylesheet' id='kadence-fonts-gfonts-css' href='https://fonts.googleapis.com/css?family=Archivo:regular,900,700,600&#038;display=swap' media='all' />
