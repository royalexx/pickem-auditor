	margin-top:-10px !important;
}</style><style class="wpcode-css-snippet">header.tribe-events-header {
    display: none !important;
}
nav.tribe-events-pro-photo-nav.tribe-events-c-nav {
    border: 0px !important;
}

/* --- Begin Tribe 5 Styles --- */

/* Event Content Link Styles */

#tribe-events-content a {
    color: #3d6d99;
    text-decoration: underline;
}

/* Event Details */

.tribe-events-content h1 {
    font-size: 3.3rem !important;
    line-height: 1.1em !important;
    font-weight: 900 !important;
    color: #fff !important;
}
.tribe-events-content h2 {
    font-size: 32px !important;
    line-height: 1.1em !important;
    color: #173d6e !important;
}
.custom-event-checklist h5, .custom-event-checklist h5 a, .custom-event-checklist h5 a:hover {
    color: #173D6D !important;
    font-size: 16px !important;
    line-height: 1.1em !important;
    font-weight: 400 !important;
}

/* Featured Events */

/* Featured Events Title */
.custom-featured-events .tribe-events-pro-photo__event-title {
    font-size: 32px !important;
    font-weight: 900 !important;
    text-transform: unset !important;
    color: #3d6d99 !important;
    line-height: 1.1 !important;
}
/* Featured Events Remove Header and Next Previous */
.custom-featured-events .tribe-events-header, .custom-featured-events .tribe-events-pro-photo-nav {
    display: none !important;
}
/* Featured Events Full Width*/
.custom-featured-events .tribe-common .tribe-common-l-container {
    max-width: unset !important;
    padding-top: 0px !important;
    padding-bottom: 0px !important;
    min-height: unset !important;
}
/* Event Details Box Min Height */
.custom-featured-events .tribe-events-pro-photo__event-details-wrapper {
    min-height: 293px !important;
}

/* Upcoming Events */

/* Upcoming Events Title */
.custom-events .tribe-events-pro-photo__event-title {
    font-size: 32px !important;
    font-weight: 900 !important;
    text-transform: unset !important;
    color: #3d6d99 !important;
    line-height: 1.1 !important;
}
/* Event Details Box Min Height */
.custom-events .tribe-events-pro-photo__event-details-wrapper {
    min-height: 293px !important;
}
/* Remove Top Bottom Margin of Container */
.tribe-common--breakpoint-medium.tribe-events .tribe-events-l-container {
    padding-bottom: 0 !important;
    padding-top: 96px;
    min-height: unset !important;
}
/* Remove Left Right Margin of Container */
.custom-events .tribe-common--breakpoint-medium.tribe-common .tribe-common-l-container {
    padding-left: 0 !important;
    padding-right: 0 !important;
}
.custom-events .tribe-common--breakpoint-medium.tribe-events .tribe-events-c-top-bar__nav-link::before {
    height: unset !important;
}
/* Remove Datepicker */
.tribe-events-c-top-bar__datepicker {
    display: inherit;
    color: #3d6d99;
}
.tribe-common--breakpoint-medium.tribe-events .tribe-events-header__top-bar {
    margin-bottom: 0 !important;
}

/* Global*/

.tribe-events .tribe-events-c-subscribe-dropdown__container {
    display: none !important;
    flex-flow: unset !important;
    justify-content: unset !important;
}

.tribe-events .tribe-events-header {
    background-color: #f7f7f7 !important;
}
.custom-start-end-date {
    font-size: 13px !important;
    margin-bottom: 10px !important;
    color: #323e47 !important;
    text-transform: uppercase !important;
}
/* Removes Month Day Div */
.tribe-events-pro-photo__event-date-tag {
    display: none !important;
}
/* Removed Event Time Div */
.tribe-events-pro-photo__event-datetime {
    display: none !important;
}
.datepicker {
    z-index: 10000 !important;
}

/* Event Title Color */
.tribe-events-pro-photo__event-title a {
    color: #3d6d99 !important;
}
/* Event Title Remove Underline */
.tribe-events-pro-photo__event-title-link {
    border-bottom: none !important;
}
/* Photo Margin Bottom */
.tribe-events-pro-photo__event-featured-image-wrapper {
    margin-bottom: 0 !important;
}
/* Event Details Box */
.tribe-events-pro-photo__event-details-wrapper {
    background-color: #fff;
    padding: 30px 25px 20px !important;
    margin-left: 10px !important;
    margin-right: 10px !important;
    margin-top: -40px !important;
    margin-bottom: 10px !important;
    z-index: 9999 !important;
    position: relative !important;
}
/* Column Background and Border */
.tribe-common-g-col.tribe-events-pro-photo__event {
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-right: 1.5% !important;
    margin-left: 1.5% !important;
    margin-top: 10px !important;
    margin-bottom: 40px !important;
    background-color: #E7E6E6 !important;
    border: none !important;
    -moz-box-shadow: 0px 0px 3px 3px rgba(0,0,0,0.2) !important;
    box-shadow: 0px 0px 3px 3px rgba(0,0,0,0.2) !important;
}
/* Column Width */
.tribe-common--breakpoint-medium.tribe-events-pro .tribe-events-pro-photo__event {
    width: 30% !important;
}
/* Remove iCal Export Button*/
.tribe-events-c-ical {
    display: none !important;
}
.tribe-events-pg-template {
    padding: 0px !important;
}

/* --- End Tribe 5 Styles --- */

/* Events Listing Customization */

.upcoming-events .fusion-post-content.post-content {
    min-height: 190px;
}
.custom-events-list .fusion-post-content.post-content {
    min-height: 240px;
}
.custom-events-list .entry-title {
    font-size: 32px !important;
}

/* Event Text Customization */

.custom-event-date {
    color: #3d6d99;
    font-weight: 800;
    text-transform:uppercase;
    margin-bottom: 1em;
}
.custom-event-icons .fusion-li-item-content {
    line-height: 24px;
}
.custom-event-item-time {
    font-size: 1.25rem;
    font-weight: 600;
    color: #003d79;
    line-height: 1.25rem;
}
.custom-event-item-description {
    font-size: 0.9rem !important;
    line-height: 1rem !important;
    color: #3d6d99;
}

/* Events Customizations */

.hp-upcoming-events #tribe-events-footer {
    display: none;
}
.upcoming-events #tribe-events-footer {
    display: none;
}
.single-tribe_events #tribe-events-footer {
	display:none!important;
}
.tribe-events-title-bar {
    display: none;
}
.tribe-events-ical.tribe-events-button {
    display: none !important;
}
.fusion-post-content-container {
    display: none;
}
.fusion-content-sep.sep-double.sep-solid {
    display: none;
}
.fusion-post-content-wrapper {
    background-color: #fff;
    padding: 30px;
    margin-top: -40px;
    margin-bottom: 10px !important;
    margin-left: 10px;
    margin-right: 10px;
    position: relative;
    z-index: 999999 !important;
}
.fusion-post-wrapper {
    background-color: #E7E6E6 !important;
    border: none !important;
    padding-right: 0;
    padding-left: 0;
    padding-bottom: 1px;
    margin-right: 1.5%;
    margin-left: 1.5%;
    margin-top: 10px;
    margin-bottom: 40px;
    -webkit-box-shadow: 0px 0px 3px 3px rgba(0,0,0,0.2);
    -moz-box-shadow: 0px 0px 3px 3px rgba(0,0,0,0.2);
    box-shadow: 0px 0px 3px 3px rgba(0,0,0,0.2);
}
#tribe-events-content {
    margin-bottom: 0 !important;
}
.upcoming-events h2.entry-title {
    font-size: 32px !important;
}

/* Events Page Customization */

.fusion-events-featured-image {
    display: none;
}
.tribe-events-cal-links {
    display: none !important;
}
.single-tribe_events .tribe-events-single-event-description {
    margin-bottom: 0;
}
.event-title-uppercase {
    text-transform: uppercase;
}
/*.fusion-checklist .fusion-li-icon, ul.fusion-checklist .fusion-li-icon {
    vertical-align: top;
}*/
.fusion-li-icon.fa-horse.fas {
    content: url("/wp-content/uploads/2019/04/icon-horseshoe.png");
}

/* Events Buttons Old */

.event-button-width {
    width: 250px !important;
}
.fusion-sharing-box h4 {
    font-size: 15px;
    font-weight: normal;
}

/* Events Buttons */

.hp-event-button {
    width: 48% !important;
    float: left !important;
    margin-right: 4% !important;
}
.hp-ticket-button {
    width: 48% !important;
    margin-left: 52% !important;
}
@media only screen and (max-width: 1264px) {
    .hp-event-button {
        width: 100% !important;
        float: none !important;
        margin-right: 0 !important;
        margin-bottom: 15px !important;
    }
    .hp-ticket-button {
        width: 100% !important;
        margin-left: 0 !important;
    }
}

.events-learn-more-button, .events-get-tickets-button {
    color: #ffffff !important;
    border-radius: 2px !important;
    padding: 13px 29px !important;
    line-height: 20px !important;
    font-size: 13px !important;
    text-transform: uppercase !important;
    width: 100% !important;
    text-align: center !important;
    font-weight: 600 !important;
    margin-bottom: 15px !important;
}
.events-learn-more-button {
    background: #3d6d99 !important;
}
.events-get-tickets-button {
	background: #003d79 !important;
}
.events-learn-more-button a, .events-get-tickets-button a {
    color:#fff !important;
}
.events-view-all-button, .events-view-all-button:hover {
	color: #ffffff;
	background: rgba(255,255,255,0);
	border-color: #ffffff;
	border-width: 1px;
}
.events-view-all-button:hover {
	background: rgba(255,255,255,0.2);
}
.meta {
    display: block !important;
}
.recent-posts-content p {
    display: none;
    padding-bottom: 20px !important;
}
.fusion-recent-posts .columns .column .meta {
    margin-top: 20px !important;
}
.tribe-events-list .time-details, .tribe-events-list .tribe-event-schedule-details {
    padding: 0;
}
.fusion-section-separator.section-separator.slant.event-slant {
    margin-left: calc( (100vw - 100% ) / -2 ) !important;
    margin-right: calc( (100vw - 100% ) / -2 ) !important;
}
#tribe-events-content {
    overflow: inherit;
}

/* Events List Customization */

.tribe-events-list-event-description .fusion-read-more {
    display: none;
    margin-top: 0;
}
.fusion-section-separator.section-separator.slant.event-slant {
    margin-bottom: -4px;
}

/* Event Sidebar Buttons Align Text Center */

/*a.fusion-button.button-flat.fusion-button-default-size.button-default.button-3.fusion-button-span-yes.fusion-button-default-type.fusion-animated.event-sidebar-buttons {
    text-align: center !important;
}*/

.fusion-button-text {
    text-align: center !important;
}

/**/

.tribe-events-content a {
    border-bottom: none !important;
}</style><style class="wpcode-css-snippet">/* Target the form input fields */
.gform_wrapper input[type="text"],
.gform_wrapper input[type="email"],
.gform_wrapper input[type="url"],
.gform_wrapper input[type="tel"],
.gform_wrapper input[type="number"],
.gform_wrapper input[type="date"],
.gform_wrapper select,
.gform_wrapper textarea {
	color: #000000 !important;
}</style><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
