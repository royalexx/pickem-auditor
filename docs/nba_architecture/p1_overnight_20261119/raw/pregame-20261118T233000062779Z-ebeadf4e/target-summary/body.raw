zed":"2026-11-17T07:04:38Z","originallyPosted":"2026-11-17T07:04:37Z","lastModified":"2026-11-17T07:04:38Z","published":"2026-11-17T07:04:37Z","root":"nba","section":"NBA","source":"Data Skrive","images":[],"video":[],"categories":[{"id":9577,"type":"league","uid":"s:40~l:46","guid":"7b3729c9-7f69-308a-bf8a-ee15a6aba154","description":"NBA","sportId":46,"leagueId":46,"league":{"id":46,"description":"NBA","abbreviation":"NBA","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nba/"}},"web":{"leagues":{"href":"https://www.espn.com/nba/"}}}}},{"id":4408,"type":"team","uid":"s:40~l:46~t:5","guid":"ec79ad1f-e6d2-7762-a2db-7fe97d35126b","description":"Cleveland Cavaliers","sportId":46,"teamId":5,"team":{"id":5,"description":"Cleveland Cavaliers","abbreviation":"CLE","shortDisplayName":"Cavaliers","links":{"mobile":{"teams":{"href":"https://www.espn.com/nba/team/_/name/cle/cleveland-cavaliers"}},"web":{"teams":{"href":"https://www.espn.com/nba/team/_/name/cle/cleveland-cavaliers"}}}}},{"id":4584,"type":"team","uid":"s:40~l:46~t:29","guid":"af5d4942-aeb5-2d07-2a8a-f70b54617e51","description":"Memphis Grizzlies","sportId":46,"teamId":29,"team":{"id":29,"description":"Memphis Grizzlies","abbreviation":"MEM","shortDisplayName":"Grizzlies","links":{"mobile":{"teams":{"href":"https://www.espn.com/nba/team/_/name/mem/memphis-grizzlies"}},"web":{"teams":{"href":"https://www.espn.com/nba/team/_/name/mem/memphis-grizzlies"}}}}},{"type":"event","uid":"s:40~l:46~e:401910007","guid":"beef4f12-6c9a-3950-9ff0-47d403adaf7f","description":"Memphis Grizzlies @ Cleveland Cavaliers","eventId":401910007,"event":{"id":401910007,"sport":"basketball","league":"nba","description":"Memphis Grizzlies @ Cleveland Cavaliers"}}],"keywords":["NBA","Cleveland Cavaliers","Memphis Grizzlies","Memphis Grizzlies @ Cleveland Cavaliers"],"story":"<a href=\"http://www.espn.com/nba/team/_/name/mem/memphis-grizzlies\">Memphis Grizzlies</a> (10-4, fifth in the Western Conference) vs. <a href=\"http://www.espn.com/nba/team/_/name/cle/cleveland-cavaliers\">Cleveland Cavaliers</a> (8-7, seventh in the Eastern Conference)\n\n\r\n              Cleveland; Wednesday, 7 p.m. EST\n\n\r\n              BOTTOM LINE: Memphis is looking to build upon its three-game win streak with a victory against Cleveland.\n\n\r\n              The Cavaliers are 6-2 on their home court. Cleveland averages 13.4 turnovers per game and is 3-3 when it turns the ball over less than its opponents.\n\n\r\n              The Grizzlies are 7-0 on the road. Memphis scores 121.7 points and has outscored opponents by 9.4 points per game.\n\n\r\n              The 118.1 points per game the Cavaliers average are 5.8 more points than the Grizzlies give up (112.3). The Grizzlies are shooting 47.7% from the field, 2.7% higher than the 45.0% the Cavaliers' opponents have shot this season.\n\n\r\n              TOP PERFORMERS: <a href=\"http://www.espn.com/nba/player/_/id/3908809/donovan-mitchell\">Donovan Mitchell</a> is averaging 24.1 points and 5.5 assists for the Cavaliers. <a href=\"http://www.espn.com/nba/player/_/id/3992/james-harden\">James Harden</a> is averaging 14.2 points and 5.4 assists over the past 10 games.\n\n\r\n              <a href=\"http://www.espn.com/nba/player/_/id/5041935/cameron-boozer\">Cameron Boozer</a> is averaging 16.5 points, 9.5 rebounds and 5.4 assists for the Grizzlies. <a href=\"http://www.espn.com/nba/player/_/id/4903027/cedric-coward\">Cedric Coward</a> is averaging 14.3 points, 8.5 rebounds, 3.7 assists and 1.7 steals over the past 10 games.\n\n\r\n              LAST 10 GAMES: Cavaliers: 5-5, averaging 118.1 points, 45.6 rebounds, 28.1 assists, 7.5 steals and 4.3 blocks per game while shooting 48.2% from the field. Their opponents have averaged 115.2 points per game.\n\n\r\n              Grizzlies: 6-4, averaging 123.7 points, 46.4 rebounds, 30.4 assists, 6.6 steals and 4.6 blocks per game while shooting 48.7% from the field. Their opponents have averaged 114.4 points.\n\n\r\n              INJURIES: Cavaliers: <a href=\"http://www.espn.com/nba/player/_/id/5106268/nae'qwan-tomlin\">Nae'Qwan Tomlin</a>: out (back), <a href=\"http://www.espn.com/nba/player/_/id/4432158/evan-mobley\">Evan Mobley</a>: out (toe), <a href=\"http://www.espn.com/nba/player/_/id/4683747/jaylon-tyson\">Jaylon Tyson</a>: out (ankle), <a href=\"http://www.espn.com/nba/player/_/id/4066757/sam-merrill\">Sam Merrill</a>: out (elbow).\n\n\r\n              Grizzlies: <a href=\"http://www.espn.com/nba/player/_/id/4432810/isaiah-stewart\">Isaiah Stewart</a>: out (illness), <a href=\"http://www.espn.com/nba/player/_/id/4431785/scotty-pippen-jr\">Scotty Pippen Jr</a>.: out (back), <a href=\"http://www.espn.com/nba/player/_/id/5105550/gg-jackson\">GG Jackson</a>: out (foot), <a href=\"http://www.espn.com/nba/player/_/id/4065733/ty-jerome\">Ty Jerome</a>: out (hip), <a href=\"http://www.espn.com/nba/player/_/id/5105462/richie-saunders\">Richie Saunders</a>: out (knee).\n\n\r\n              ------\n\n\r\n              The Associated Press created this story using technology provided by <a href=\"https://www.dataskrive.com/\">Data Skrive</a> and data from <a href=\"https://www.sportradar.com\">Sportradar</a>.","allowContentReactions":false,"allowSearch":true,"isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50508602"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50508602"}},"mobile":{"href":"http://m.espn.go.com/nba/story?storyId=50508602"},"web":{"href":"http://www.espn.com/nba/preview?gameId=401910007"}},"premium":false},"videos":[],"wallclockAvailable":false,"ticketsInfo":{"tickets":[{"ticketName":"All NBA Tickets","ticketLink":"https://www.vividseats.com/nba-basketball/?wsUser=717","type":"league"},{"ticketName":"All Cavaliers Tickets","ticketLink":"https://www.vividseats.com/cleveland-cavaliers-tickets--sports-nba-basketball/performer/182?wsUser=717","type":"team"},{"ticketName":"11/18 vs Grizzlie