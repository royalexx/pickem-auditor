:"Missed","isFieldGoal":1,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"MISS Sensabaugh 7' Driving Floating Jump Shot","actionType":"Missed Shot","subType":"Driving Floating Jump Shot","videoAvailable":1,"shotValue":2,"actionId":513},{"actionNumber":718,"clock":"PT00M44.60S","period":4,"teamId":1610612762,"teamTricode":"UTA","personId":1641729,"playerName":"Sensabaugh","playerNameI":"B. Sensabaugh","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Sensabaugh REBOUND (Off:2 Def:1)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":514},{"actionNumber":719,"clock":"PT00M43.00S","period":4,"teamId":1610612762,"teamTricode":"UTA","personId":1641729,"playerName":"Sensabaugh","playerNameI":"B. Sensabaugh","xLegacy":8,"yLegacy":2,"shotDistance":1,"shotResult":"Made","isFieldGoal":1,"scoreHome":"115","scoreAway":"98","pointsTotal":213,"location":"v","description":"Sensabaugh 1' Putback Layup (2 PTS)","actionType":"Made Shot","subType":"Putback Layup Shot","videoAvailable":1,"shotValue":2,"actionId":515},{"actionNumber":720,"clock":"PT00M25.30S","period":4,"teamId":1610612750,"teamTricode":"MIN","personId":1630538,"playerName":"Hyland","playerNameI":"B. Hyland","xLegacy":-162,"yLegacy":202,"shotDistance":26,"shotResult":"Missed","isFieldGoal":1,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"MISS Hyland 26' 3PT Pullup Jump Shot","actionType":"Missed Shot","subType":"Pullup Jump shot","videoAvailable":1,"shotValue":3,"actionId":516},{"actionNumber":721,"clock":"PT00M25.30S","period":4,"teamId":1610612762,"teamTricode":"UTA","personId":1642271,"playerName":"Filipowski","playerNameI":"K. Filipowski","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Filipowski REBOUND (Off:2 Def:4)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":517},{"actionNumber":722,"clock":"PT00M14.30S","period":4,"teamId":1610612762,"teamTricode":"UTA","personId":1642268,"playerName":"Collier","playerNameI":"I. Collier","xLegacy":1,"yLegacy":13,"shotDistance":1,"shotResult":"Made","isFieldGoal":1,"scoreHome":"115","scoreAway":"100","pointsTotal":215,"location":"v","description":"Collier 1' Driving Finger Roll Layup (6 PTS)","actionType":"Made Shot","subType":"Driving Finger Roll Layup Shot","videoAvailable":1,"shotValue":2,"actionId":518},{"actionNumber":723,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"115","scoreAway":"100","pointsTotal":215,"location":"","description":"End of 4th Period (9:33 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":519}],"source":"hanaV3"},"headline":"Wolves clamp on Jazz","heroImage":"https://cdn.nba.com/manage/2026/11/GettyImages-2303787759-scaled-e1794191739552.jpg","story":{"header":{"headline":"Dosunmu, Ball lead Timberwolves past slumping Jazz, 115-100","byline":"By PATRICK DONNELLY","bytitle":"Associated Press"},"date":"2026-11-08T21:54:30","content":["MINNEAPOLIS (AP)  Ayo Dosunmu scored 26 points and LaMelo Ball added 24 points and five assists to help the Minnesota Timberwolves beat the Utah Jazz 115-100 on Sunday night.","Jaden McDaniels finished with 16 points, Bones Hyland had 14 off the bench, and Rudy Gobert chipped in 10 points and 15 rebounds for the Wolves (8-3), who have won four in a row and are 5-2 without Anthony Edwards. The All-Star guard is expected to miss two months after undergoing knee surgery Oct. 29.","Darryn Peterson led the Jazz with 26 points and six rebounds. Keyonte George scored 19 points in three quarters before missing the fourth quarter with a sprained right ankle.","After splitting their first two games of the season, the Jazz have lost eight in a row and sit at the bottom of the Western Conference. They played Sunday without forward Lauri Markkanen (right wrist), who hit eight 3-pointers in a loss at Dallas on Friday night.","Ball brought the crowd to its feet when he made a steal at midcourt and cruised to an uncontested dunk, giving Minnesota a 70-63 lead midway through the third quarter.","Hyland then checked in and scored seven quick points as the Timberwolves ended the third quarter with their biggest lead at 90-72.","Utah began the fourth quarter 0 for 9 from the floor and was held scoreless for almost four minutes as Minnesota built its lead to as much as 19 points.","The Timberwolves entered the game with the worst free-throw percentage in the league at .648, but they made 27 of 32 from the line Sunday, with Dosunmu going 8 for 8.","The game kicked off a season-long eight-game homestand for the Timberwolves. They won’t play a game outside Target Center until the day before Thanksgiving.","Jazz: Host Miami on Tuesday night.","Timberwolves: Host Dallas on Thursday night.","---","See AP’s full NBA coverage here","---","See AP’s full NBA coverage here"],"storyType":"recap"},"postId":2424403,"view":{"id":"play-by-play","label":"Play-By-Play"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"UTA @ MIN, 2026-11-08","gameID":"0022600198","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"SiriusXM;DAZN-MIN;WCCO;KJZZ;KSL-FM/KTUB;DTC-UTA","venue":"Target Center, Minneapolis, MN","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2425049,"title":"Darryn Peterson scores career-high 26 points","shortTitle":"Darryn Peterson scores career-high 26 points","permalink":"https://www.nba.com/watch/video/