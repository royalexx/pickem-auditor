esult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"TIMBERWOLVES Timeout: Regular (Full 6 Short 0)","actionType":"Timeout","subType":"Regular","videoAvailable":0,"shotValue":0,"actionId":520},{"actionNumber":728,"clock":"PT00M43.40S","period":4,"teamId":1610612750,"teamTricode":"MIN","personId":1630183,"playerName":"McDaniels","playerNameI":"J. McDaniels","xLegacy":227,"yLegacy":87,"shotDistance":24,"shotResult":"Missed","isFieldGoal":1,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"MISS McDaniels 24' 3PT Step Back Jump Shot","actionType":"Missed Shot","subType":"Step Back Jump shot","videoAvailable":1,"shotValue":3,"actionId":521},{"actionNumber":729,"clock":"PT00M43.40S","period":4,"teamId":1610612741,"teamTricode":"CHI","personId":1630171,"playerName":"Okoro","playerNameI":"I. Okoro","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Okoro REBOUND (Off:2 Def:5)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":522},{"actionNumber":730,"clock":"PT00M17.20S","period":4,"teamId":0,"teamTricode":"","personId":1610612741,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Bulls Turnover: Shot Clock (T#19)","actionType":"Turnover","subType":"Shot Clock Turnover","videoAvailable":1,"shotValue":0,"actionId":523},{"actionNumber":731,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"106","scoreAway":"117","pointsTotal":223,"location":"","description":"End of 4th Period (10:26 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":524}],"source":"hanaV3"},"headline":"Bulls cool off Wolves","heroImage":"https://cdn.nba.com/manage/2026/11/GettyImages-2304659949-scaled-e1794713361957.jpg","story":{"header":{"headline":"Bulls overcome travel delay and injuries to beat the Timberwolves 117-106","byline":"By TYLER MASON","bytitle":"Associated Press"},"date":"2026-11-14T22:36:51","content":["MINNEAPOLIS (AP)  Norman Powell scored 23 points, Matas Buzelis added 18 points and nine rebounds, and the short-handed Chicago Bulls won for the second night in a row with a 117-106 victory over the Minnesota Timberwolves on Saturday.","Buddy Hield and Tre Jones each chipped in 16 points off the bench for the Bulls, who ended Minnesota's five-game winning streak convincingly.","Chicago's travel to Minneapolis on Friday was delayed by the nationwide ground stop that impacted many flights across the country. That meant the Bulls didn't arrive to Minnesota until the day of the game Saturday after beating the Hawks in Chicago on Friday.","The travel disruption didn't seem to impact the Bulls, nor did a limited roster. Rookie Caleb Wilson is out for an extended period with a fractured hand. Jalen Smith also missed Saturday's game with a hand injury, and center Nic Claxton was sidelined with a hamstring injury.","Buzelis picked up the scoring in their absence with 14 first-half points.","The Timberwolves missed their first 13 shots from 3-point range and finished 9 for 38.","Minnesota was held to 17 points in the first quarter, its lowest-scoring quarter of the season. The Wolves failed to reach 110 points for the first time this season.","Wolves guard Ayo Dosunmu had a big third quarter against his former team to help Minnesota claw back. Dosunmu scored 14 of his team-high 24 points in the period. LaMelo Ball added 19 points.","Chicago had no problem scoring at the rim in the first half. The Bulls scored 30 points of their 58 first-half points in the paint and finished with 54 paint points for the game. The Bulls also connected on 7 of 15 shots from deep before halftime.","Bulls: Play at Cleveland on Monday.","Timberwolves: Host Portland on Monday.","---","See AP’s full NBA coverage here"],"storyType":"recap"},"postId":2433739,"view":{"id":"play-by-play","label":"Play-By-Play"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"CHI @ MIN, 2026-11-14","gameID":"0022600235","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"ESPN_Aus;QQ;ESPN_I_NZ;Videoland / Hami Video;TSN+;SiriusXM;DAZN-MIN;WCCO;CHSN/CHSN App;WSCR","venue":"Target Center, Minneapolis, MN","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2434309,"title":"Minnesota Timberwolves vs. Chicago Bulls - 4th Quarter Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/minnesota-timberwolves-vs-chicago-bulls-4th-quarter-highlights-2?plsrc=nba\u0026game-highlights=0022600235","videoDuration":"01:28","featuredImage":"https://cdn.nba.com/manage/2026/11/8aa5e840-ab24-4c87-bac5-3175fb4a9172_0-1.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2434307,"title":"Minnesota Timberwolves vs. Chicago Bulls - 2nd Half Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/minnesota-timberwolves-vs-chicago-bulls-2nd-half-highlights-2?plsrc=nba\u0026game-highlights=0022600235","videoDuration":"01:27","featuredImage":"https://cdn.nba.com/manage/2026/11/8aa5e840-ab24-4c87-bac5-3175fb4a9172_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2434290,"title":"Dunk by Isaac Okoro","shortTitle":"","permalink":"https://www.nba.com/watch/video/dunk-by-isaac-okoro-11?plsrc=nba\u0026game-highlights=0022600235","videoDuration":"00:10","featuredImage":"https://c