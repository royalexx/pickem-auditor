2600235","play-by-play"]},"istGroup":{},"banner":{"desktop":"https://cdn.nba.com/manage/2025/09/header-inside-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600235","gameCode":"20261114/CHIMIN","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-15T01:00:00Z","gameEt":"2026-11-14T20:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-15T01:10:44Z","actualEndTimeUTC":"2026-11-15T03:26:04Z","gameDurationSeconds":8120,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612750,"teamName":"Timberwolves","teamCity":"Minnesota","teamTricode":"MIN","teamSlug":"timberwolves","wins":9,"losses":4,"score":106,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":2,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":17},{"period":2,"periodType":"REGULAR","score":28},{"period":3,"periodType":"REGULAR","score":35},{"period":4,"periodType":"REGULAR","score":26}],"starters":[{"personId":203497,"position":"C","lastName":"Gobert","firstName":"Rudy","status":"Confirmed"},{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630228,"position":"PF","lastName":"Kuminga","firstName":"Jonathan","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"}]},"awayTeam":{"teamId":1610612741,"teamName":"Bulls","teamCity":"Chicago","teamTricode":"CHI","teamSlug":"bulls","wins":3,"losses":9,"score":117,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":29},{"period":2,"periodType":"REGULAR","score":29},{"period":3,"periodType":"REGULAR","score":30},{"period":4,"periodType":"REGULAR","score":29}],"starters":[{"personId":1626181,"position":"SG","lastName":"Powell","firstName":"Norman","status":"Confirmed"},{"personId":1628380,"position":"C","lastName":"Collins","firstName":"Zach","status":"Confirmed"},{"personId":1630171,"position":"SF","lastName":"Okoro","firstName":"Isaac","status":"Confirmed"},{"personId":1630581,"position":"PG","lastName":"Giddey","firstName":"Josh","status":"Confirmed"},{"personId":1641824,"position":"PF","lastName":"Buzelis","firstName":"Matas","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Chicago Bulls Earn the Win","body":"The Chicago Bulls defeated the Minnesota Timberwolves 117-106. Ayo Dosunmu led the Timberwolves with 24 points on efficient 10-for-16 shooting, while LaMelo Ball added 19 points, 8 rebounds and 6 assists. For the Bulls, Norman Powell scored 24 points on 10-for-19 shooting with 5 rebounds and 3 assists, and Matas Buzelis contributed 18 points and 9 rebounds.\n\nChicago's defense set the tone early, with the Bulls going on a 22–6 run from 10:31 to 3:44 of the first quarter to establish control. Minnesota fought back throughout the contest, mounting a 13–0 run from 8:37 to 6:01 of the third quarter to keep pace. The teams traded baskets down the stretch, with Isaac Okoro throwing down a dunk that made the score 113–102 in favor of the Bulls with 2:16 remaining in the fourth. The Chicago Bulls held an edge in bench scoring, while the Minnesota Timberwolves had an edge in free-throw opportunities.\n\nDosunmu's efficiency from the field was notable; Jaden McDaniels shot 12.5 percentage points above expectation in his effort to keep Minnesota competitive. Powell drew above-expected defensive pressure on the perimeter, recording an Average Gravity of 10.5, while Ball's overall impact registered a Total Leverage of 2.4 as the Timberwolves pushed to stay close in the final minutes."}},"defining_moments":{"gameId":"0022600235","moduleType":"defining_moments","definingMoments":[{"guid":"15c2d8df-2861-028d-f5e5-030f966b0186","rank":1,"title":"Isaac Okoro Throws It Down","summary":"Isaac Okoro threw down a dunk, and the Bulls led 113–102 with 2:16 remaining in the fourth.","category":"Scoring","eventNum":699,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600235/699/15c2d8df-2861-028d-f5e5-030f966b0186_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600235/699/15c2d8df-2861-028d-f5e5-030f966b0186_1280x720.mp4","playerId":1630171,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600235/699/15c2d8df-2861-028d-f5e5-030f966b0186_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600235/699/15c2d8df-2861-028d-f5e5-030f966b0186_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600235/699/15c2d8df-2861-028d-f5e5-030f966b0186.m3u8","largeDuration":7666,"smallDuration":7666,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600235/699/15c2d8df-2861-028d-f5e5-030f966b0186_1280x720.jpg","mediumDuration":7666,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600235/699/15c2d8df-2861-028d-f5e5-030f966b0186_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600235/699/15c2d8df-2861-028d-f5e5-030f966b0186_960x540.jp