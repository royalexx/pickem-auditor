k":"PT00M09.40S","period":4,"teamId":0,"teamTricode":"","personId":1610612763,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"GRIZZLIES Turnover: Shot Clock (T#14)","actionType":"Turnover","subType":"Shot Clock Turnover","videoAvailable":1,"shotValue":0,"actionId":514},{"actionNumber":727,"clock":"PT00M02.00S","period":4,"teamId":1610612751,"teamTricode":"BKN","personId":1631169,"playerName":"Minott","playerNameI":"J. Minott","xLegacy":97,"yLegacy":240,"shotDistance":26,"shotResult":"Missed","isFieldGoal":1,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"MISS Minott 26' 3PT Pullup Jump Shot","actionType":"Missed Shot","subType":"Pullup Jump shot","videoAvailable":1,"shotValue":3,"actionId":515},{"actionNumber":728,"clock":"PT00M02.00S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1643510,"playerName":"López","playerNameI":"K. López","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"Lopez REBOUND (Off:1 Def:1)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":516},{"actionNumber":729,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"129","scoreAway":"110","pointsTotal":239,"location":"","description":"End of 4th Period (10:30 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":517}],"source":"hanaV3"},"headline":"Grizzlies roll at home","heroImage":"https://cdn.nba.com/manage/2026/11/GettyImages-2304659954-scaled-e1794713570554.jpg","story":{"header":{"headline":"Cedric Coward has 23 points and 12 rebounds as Grizzlies beat Nets 129-110","byline":"By BY CLAY BAILEY","bytitle":"Associated Press"},"date":"2026-11-14T22:47:23","content":["MEMPHIS, Tenn. (AP)  Cedric Coward had 23 points and 12 rebounds and Taylor Hendricks scored a career-high 22 as Memphis built an early lead and defeated the Brooklyn Nets 129-110 on Saturday night.","A night after a 142-111 victory over New Orleans featured 10 Memphis players reaching double figures, tying an NBA record, seven Grizzlies reached double figures against the Nets. Javon Small scored 19 and Cam Spencer finished with 17 and eight assists as Memphis won its third in the last four.","Julius Randle lead Brooklyn with 22 points and Day’Ron Sharpe added 16 points and 11 rebounds as Brooklyn lost its third in the last four. Noah Clowney scored 15.","Memphis built a 20-point first-half lead behind 3-point success and weathered a third quarter Brooklyn burst that cut the advantage to single digits. By early in the fourth quarter, Memphis had taken the lead back to 24.","Both teams had to overcome travel issues out of New Orleans that plagued the country during Friday's grounding of planes. The Nets stayed over after playing New Orleans on Wednesday; the Grizzlies beat the Pelicans on Friday night.","The teams arrived midday Saturday only hours before tipoff. That led to compressed game preparation.","Then Brooklyn's leading scorer and rebounder Michael Porter Jr. was a late scratch for personal reasons, eliminating 21.5 points and 7.5 rebounds from the Nets arsenal. The Grizzlies were without starters Ty Jerome, the team's leading scorer, and center Zach Edey.","Memphis built an early double-digit lead behind starting 9 of 11 from 3-point range. The Nets shooting would improve in the second quarter, but Spencer's 3-pointer as time expired in the second - their 13th of the half - gave Memphis a 71-54 lead at the break.","Nets: Host Philadelphia on Monday.","Grizzlies: At Wahington on Monday.","---","See AP’s full NBA coverage here"],"storyType":"recap"},"postId":2433738,"view":{"id":"play-by-play","label":"Play-By-Play"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"BKN @ MEM, 2026-11-14","gameID":"0022600234","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"NBAC;SiriusXM;DAZN-MEM;WMFS;YES/DAZN-YES;WFAN-FM/AM","venue":"FedExForum, Memphis, TN","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2434333,"title":"Memphis Grizzlies vs. Brooklyn Nets - 4th Quarter Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/memphis-grizzlies-vs-brooklyn-nets-4th-quarter-highlights-2?plsrc=nba\u0026game-highlights=0022600234","videoDuration":"01:28","featuredImage":"https://cdn.nba.com/manage/2026/11/ca51be9c-dbe7-4875-bf15-703df6d67132_0-1.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2434316,"title":"Memphis Grizzlies vs. Brooklyn Nets - 2nd Half Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/memphis-grizzlies-vs-brooklyn-nets-2nd-half-highlights-2?plsrc=nba\u0026game-highlights=0022600234","videoDuration":"01:22","featuredImage":"https://cdn.nba.com/manage/2026/11/11fd5e63-0697-4777-ac4d-6a33aad1a6d7_0-3.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2434292,"title":"Cedric Coward ascends for the slam!","shortTitle":"","permalink":"https://www.nba.com/watch/video/cedric-coward-ascends-for-the-slam-5?plsrc=nba\u0026game-highlights=0022600234","videoDuration":"00:22","featuredImage":"https://cdn.nba.com/manage/2026/11/4776134a-51d9-4ac5-a233-008c37d20d8f_0.jpg","entitlements":"","videoFranchisesName":{"4-to-5-stars":"Rated Plays"}},{"id":2434293,"title":"Dunk by Cedric Coward","shortTitle":"","permalink":"https://www.nba.com/watch/video/dunk-by-