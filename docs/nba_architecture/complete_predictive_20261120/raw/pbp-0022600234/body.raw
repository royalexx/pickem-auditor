,"gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-15T01:00:00Z","gameEt":"2026-11-14T20:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-15T01:10:51Z","actualEndTimeUTC":"2026-11-15T03:29:40Z","gameDurationSeconds":8329,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612763,"teamName":"Grizzlies","teamCity":"Memphis","teamTricode":"MEM","teamSlug":"grizzlies","wins":9,"losses":4,"score":129,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":38},{"period":2,"periodType":"REGULAR","score":33},{"period":3,"periodType":"REGULAR","score":32},{"period":4,"periodType":"REGULAR","score":26}],"starters":[{"personId":1630191,"position":"C","lastName":"Stewart","firstName":"Isaiah","status":"Confirmed"},{"personId":1642285,"position":"PG","lastName":"Spencer","firstName":"Cam","status":"Confirmed"},{"personId":1642377,"position":"SF","lastName":"Wells","firstName":"Jaylen","status":"Confirmed"},{"personId":1642907,"position":"SG","lastName":"Coward","firstName":"Cedric","status":"Confirmed"},{"personId":1643409,"position":"PF","lastName":"Boozer","firstName":"Cameron","status":"Confirmed"}]},"awayTeam":{"teamId":1610612751,"teamName":"Nets","teamCity":"Brooklyn","teamTricode":"BKN","teamSlug":"nets","wins":3,"losses":9,"score":110,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":0,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":23},{"period":2,"periodType":"REGULAR","score":31},{"period":3,"periodType":"REGULAR","score":30},{"period":4,"periodType":"REGULAR","score":26}],"starters":[{"personId":203944,"position":"PF","lastName":"Randle","firstName":"Julius","status":"Confirmed"},{"personId":1630549,"position":"C","lastName":"Sharpe","firstName":"Day'Ron","status":"Confirmed"},{"personId":1641730,"position":"SF","lastName":"Clowney","firstName":"Noah","status":"Confirmed"},{"personId":1642856,"position":"PG","lastName":"Dëmin","firstName":"Egor","status":"Confirmed"},{"personId":1642874,"position":"SG","lastName":"Wolf","firstName":"Danny","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Memphis Grizzlies Earn the Win","body":"The Memphis Grizzlies defeated the Brooklyn Nets 129-110. Cedric Coward led the Memphis Grizzlies with 23 points and 12 rebounds on 7-for-13 shooting, including 4-for-6 from three, while Taylor Hendricks added 22 points on 9-for-13 accuracy from the field. For Brooklyn, Julius Randle scored 22 points with 5 assists, and Day'Ron Sharpe contributed 16 points and 11 rebounds on 7-for-14 shooting. The Memphis Grizzlies paired a substantial advantage in bench scoring with an edge in paint scoring over the Brooklyn Nets.\n\nMemphis controlled the contest through the third quarter and into the fourth, building its lead methodically. The Grizzlies went on a 25–9 run spanning the late third and early fourth quarters, extending their advantage decisively. Brooklyn mounted a response with a 15–2 run in the final minutes, but the deficit proved too large to overcome. Hendricks made a shot that made the score 123–106 in favor of the Grizzlies with 3:26 remaining in the fourth, effectively putting the game out of reach.\n\nHendricks shot 8.3 percentage points above expectation, converting at a rate higher than an average NBA player would be expected to achieve on his tracked attempts. Cedric Coward recorded Total Leverage of 3.7, reflecting his overall impact across multiple facets of play. Egor Dëmin drew above-expected defensive pressure for Brooklyn, recording Average Gravity of 13.0 as opponents faced elevated defensive attention when he was on the floor."}},"defining_moments":{"gameId":"0022600234","moduleType":"defining_moments","definingMoments":[{"guid":"004b3e6c-f4f0-423e-40ce-833dacc40de4","rank":1,"title":"Taylor Hendricks in the Spotlight","summary":"Cam Spencer found Taylor Hendricks, who converted the hook bank shot, making it 123–106 in favor of the Grizzlies with 3:26 remaining in the fourth.","category":"Scoring","eventNum":676,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600234/676/004b3e6c-f4f0-423e-40ce-833dacc40de4_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600234/676/004b3e6c-f4f0-423e-40ce-833dacc40de4_1280x720.mp4","playerId":1641707,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600234/676/004b3e6c-f4f0-423e-40ce-833dacc40de4_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600234/676/004b3e6c-f4f0-423e-40ce-833dacc40de4_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600234/676/004b3e6c-f4f0-423e-40ce-833dacc40de4.m3u8","largeDuration":10350,"smallDuration":10350,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600234/676/004b3e6c-f4f0-423e-40ce-833dacc40de4_1280x720.jpg","mediumDuration":10350,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600234/676/004b3e6c-f4f0-423e-40ce-833dacc40de4_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/14/0022600234/676/004b3e6c-f4f0-423e-40ce-833dacc40de4_960x540.jpg"},{"guid":"f6811368-41eb-6b32-e55a-e2e537eb6e67","rank":2,"titl