de-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600152","gameCode":"20261031/MINSAS","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-01T00:00:00Z","gameEt":"2026-10-31T20:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-01T00:10:37Z","actualEndTimeUTC":"2026-11-01T02:28:35Z","gameDurationSeconds":8278,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612759,"teamName":"Spurs","teamCity":"San Antonio","teamTricode":"SAS","teamSlug":"spurs","wins":4,"losses":2,"score":121,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":0,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":34},{"period":2,"periodType":"REGULAR","score":26},{"period":3,"periodType":"REGULAR","score":33},{"period":4,"periodType":"REGULAR","score":28}],"starters":[{"personId":1628368,"position":"PG","lastName":"Fox","firstName":"De'Aaron","status":"Confirmed"},{"personId":1630170,"position":"PF","lastName":"Vassell","firstName":"Devin","status":"Confirmed"},{"personId":1641705,"position":"C","lastName":"Wembanyama","firstName":"Victor","status":"Confirmed"},{"personId":1642264,"position":"SF","lastName":"Castle","firstName":"Stephon","status":"Confirmed"},{"personId":1642844,"position":"SG","lastName":"Harper","firstName":"Dylan","status":"Confirmed"}]},"awayTeam":{"teamId":1610612750,"teamName":"Timberwolves","teamCity":"Minnesota","teamTricode":"MIN","teamSlug":"timberwolves","wins":4,"losses":3,"score":111,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":28},{"period":2,"periodType":"REGULAR","score":33},{"period":3,"periodType":"REGULAR","score":27},{"period":4,"periodType":"REGULAR","score":23}],"starters":[{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630228,"position":"PF","lastName":"Kuminga","firstName":"Jonathan","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"},{"personId":1642866,"position":"C","lastName":"Beringer","firstName":"Joan","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The San Antonio Spurs Dominate with Wembanyama's 43-point masterclass","body":"The San Antonio Spurs defeated the Minnesota Timberwolves 121-111. Victor Wembanyama led the Spurs with 43 points on 17-for-34 shooting, adding 7 rebounds and 4 assists in a dominant performance. Dylan Harper contributed 25 points, 7 rebounds and 6 assists on 9-for-17 from the field. For Minnesota, Ayo Dosunmu scored 27 points and grabbed 9 rebounds while shooting 11-for-17, and Jaden McDaniels added 19 points.\n\nThe Timberwolves mounted a strong second-quarter push, going on a 26–8 run to build momentum, but San Antonio answered with precision down the stretch. The Spurs executed late in the fourth quarter, with Wembanyama hitting a three-pointer that made it 118–107 with 2:40 remaining, extending their control. San Antonio also built a 9–0 run spanning the third and fourth quarters that proved decisive in closing out the contest.\n\nDe'Aaron Fox was remarkably efficient for the Spurs, shooting 80.0% from the field—23.8 percentage points above expectation—on 8-of-10 attempts. Luke Kornet generated significant defensive attention with an Average Gravity of 8.2, pulling defenders toward him beyond what the floor spacing suggested. Fox's overall impact, measured at 3.9 Total Leverage, reflected his critical contributions in the final stretches as San Antonio secured the victory."}},"defining_moments":{"gameId":"0022600152","moduleType":"defining_moments","definingMoments":[{"guid":"caa96284-b0e9-1390-3ba7-76038297b9cc","rank":1,"title":"Victor Wembanyama Delivers a Triple","summary":"Victor Wembanyama made a three-pointer off the assist from Devin Vassell, making it 118–107 in favor of the Spurs with 2:40 remaining in the fourth.","category":"Scoring","eventNum":686,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600152/686/caa96284-b0e9-1390-3ba7-76038297b9cc_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600152/686/caa96284-b0e9-1390-3ba7-76038297b9cc_1280x720.mp4","playerId":1641705,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600152/686/caa96284-b0e9-1390-3ba7-76038297b9cc_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600152/686/caa96284-b0e9-1390-3ba7-76038297b9cc_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600152/686/caa96284-b0e9-1390-3ba7-76038297b9cc.m3u8","largeDuration":10050,"smallDuration":10050,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600152/686/caa96284-b0e9-1390-3ba7-76038297b9cc_1280x720.jpg","mediumDuration":10050,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600152/686/caa96284-b0e9-1390-3ba7-76038297b9cc_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600152/686/caa96284-b0e9-1390-3ba7-7