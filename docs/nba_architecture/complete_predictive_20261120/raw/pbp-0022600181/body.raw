PT00M19.20S","period":4,"teamId":1610612750,"teamTricode":"MIN","personId":1630245,"playerName":"Dosunmu","playerNameI":"A. Dosunmu","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Dosunmu P.FOUL (P3.PN) (T.Ford)","actionType":"Foul","subType":"Personal","videoAvailable":1,"shotValue":0,"actionId":519},{"actionNumber":729,"clock":"PT00M19.20S","period":4,"teamId":1610612745,"teamTricode":"HOU","personId":1641708,"playerName":"Thompson","playerNameI":"A. Thompson","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"107","scoreAway":"117","pointsTotal":224,"location":"h","description":"Thompson Free Throw 1 of 2 (11 PTS)","actionType":"Free Throw","subType":"Free Throw 1 of 2","videoAvailable":1,"shotValue":0,"actionId":520},{"actionNumber":730,"clock":"PT00M19.20S","period":4,"teamId":1610612745,"teamTricode":"HOU","personId":1641708,"playerName":"Thompson","playerNameI":"A. Thompson","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"MISS Thompson Free Throw 2 of 2","actionType":"Free Throw","subType":"Free Throw 2 of 2","videoAvailable":1,"shotValue":0,"actionId":521},{"actionNumber":731,"clock":"PT00M19.20S","period":4,"teamId":1610612745,"teamTricode":"HOU","personId":1641708,"playerName":"Thompson","playerNameI":"A. Thompson","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"Thompson REBOUND (Off:5 Def:3)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":522},{"actionNumber":732,"clock":"PT00M15.50S","period":4,"teamId":1610612745,"teamTricode":"HOU","personId":1641708,"playerName":"Thompson","playerNameI":"A. Thompson","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"Thompson Out of Bounds Lost Ball Turnover (P3.T22)","actionType":"Turnover","subType":"Out of Bounds Lost Ball Turnover","videoAvailable":1,"shotValue":0,"actionId":523},{"actionNumber":733,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"107","scoreAway":"117","pointsTotal":224,"location":"","description":"End of 4th Period (11:07 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":524}],"source":"hanaV3"},"headline":"Wolves catch Rockets","heroImage":"https://cdn.nba.com/manage/2026/11/GettyImages-2303087914-scaled-e1793851755544.jpg","story":{"header":{"headline":"Dosunmu scores 21 and Kuminga sparks late surge in Timberwolves’ 117-107 win over Rockets","byline":"By KRISTIE RIEKEN","bytitle":"AP Sports Writer"},"date":"2026-11-05T00:29:46","content":["HOUSTON (AP)  Ayo Dosunmu had 21 points and Jonathan Kuminga powered a fourth-quarter run that allowed the Minnesota Timberwolves to pull away for a 117-107 win over the Houston Rockets on Wednesday night.","Minnesota led by two before a 3-pointer from Kuminga, a steal by Dosunmu and a tip-in by Kuminga made it 111-104 with about two minutes remaining.","Kevin Durant made two free throws for Houston before another 3 by Kuminga extended the lead to 114-106 with less than a minute to go.","LaMelo Ball scored 12 of his 20 points in the fourth quarter for Minnesota after finishing with a season-high 34 in his previous game.","Alperen Sengun had his 13th career triple-double with 17 points, 12 rebounds and 10 assists to lead the Rockets as they lost for just the second time this season. Durant added 21 points and Fred VanVleet had 18.","Kuminga finished with 16 points and eight rebounds. Jaden McDaniels had 14 points and eight boards for the Timberwolves.","The Rockets led by two midway through the fourth quarter before Ball scored seven points during a 10-2 run that gave the Timberwolves a 104-98 lead with about five minutes to play.","Sengun made one of two free throws before a 3-pointer by VanVleet got the Rockets within 104-102 about a minute later.","Already without star Anthony Edwards for up to two months after arthroscopic knee surgery, the Timberwolves also played without guard Terrence Shannon Jr., who missed his second straight game with a bruised hip.","Kuminga received a flagrant foul 1 in the second quarter after elbowing Sengun in the jaw and knocking him to the court.","Timberwolves: Visit New Orleans on Friday night.","Rockets: Visit Phoenix on Saturday night.","---","See AP’s full NBA coverage here"],"storyType":"recap"},"postId":2417565,"view":{"id":"play-by-play","label":"Play-By-Play"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"MIN @ HOU, 2026-11-04","gameID":"0022600181","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"SportTVPor;NBATV_PH_Cignal;Videoland / Elta TV;Coupang Play;SiriusXM;SCHN/SCHN+;KBME/KTRH/K269GT;DAZN-MIN;WCCO","venue":"Toyota Center, Houston, TX","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2419423,"title":"LaMelo Ball takes over with 12 points in the 4th to defeat Rockets","shortTitle":"","permalink":"https://www.nba.com/watch/video/lamelo-ball-takes-over-with-12-points-in-the-4th-to-defeat-rockets?plsrc=nba\u0026game-highlights=0022600181","videoDuration":"00:53","featuredImage":"https://cdn.nba.com/manage/2026/11/c2120faa-0a10-45a5-a8ac-47b2f3c4ec61_0.jpg","entitlements":"","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2419385,"title":"Houston Rockets vs. Minnesota Timberwolves - 2nd 