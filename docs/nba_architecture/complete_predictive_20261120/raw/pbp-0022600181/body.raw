mCity":"Houston","teamTricode":"HOU","teamSlug":"rockets","wins":7,"losses":2,"score":107,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":0,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":30},{"period":2,"periodType":"REGULAR","score":27},{"period":3,"periodType":"REGULAR","score":27},{"period":4,"periodType":"REGULAR","score":23}],"starters":[{"personId":201142,"position":"SF","lastName":"Durant","firstName":"Kevin","status":"Confirmed"},{"personId":1627832,"position":"PG","lastName":"VanVleet","firstName":"Fred","status":"Confirmed"},{"personId":1630578,"position":"C","lastName":"Sengun","firstName":"Alperen","status":"Confirmed"},{"personId":1631095,"position":"PF","lastName":"Smith Jr.","firstName":"Jabari","status":"Confirmed"},{"personId":1641708,"position":"SG","lastName":"Thompson","firstName":"Amen","status":"Confirmed"}]},"awayTeam":{"teamId":1610612750,"teamName":"Timberwolves","teamCity":"Minnesota","teamTricode":"MIN","teamSlug":"timberwolves","wins":6,"losses":3,"score":117,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":33},{"period":2,"periodType":"REGULAR","score":24},{"period":3,"periodType":"REGULAR","score":25},{"period":4,"periodType":"REGULAR","score":35}],"starters":[{"personId":203497,"position":"C","lastName":"Gobert","firstName":"Rudy","status":"Confirmed"},{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630228,"position":"PF","lastName":"Kuminga","firstName":"Jonathan","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Minnesota Timberwolves Earn the Win","body":"The Minnesota Timberwolves defeated the Houston Rockets 117-107. Ayo Dosunmu led the Minnesota Timberwolves with 21 points on 10-for-20 shooting, adding 6 assists and 1 rebound, while LaMelo Ball contributed 20 points on 6-for-11 from the field and 4-for-7 from three-point range with 6 assists. For the Houston Rockets, Kevin Durant matched Dosunmu's 21 points on 7-for-14 shooting with 5 rebounds and 2 assists, and Fred VanVleet added 18 points on 6-for-12 from the field and 4-for-9 from three.\n\nThe Rockets built early momentum with an 8–0 run in the opening quarter, but the Timberwolves answered with sustained offensive execution throughout the contest. Minnesota's attack accelerated down the stretch, when the Timberwolves mounted an 11–2 run over the final two minutes of the fourth quarter to pull away. The Minnesota Timberwolves paired an edge in paint scoring with an edge in fast-break scoring over the Houston Rockets. Jonathan Kuminga's layup made the score 111–104 in favor of the Timberwolves with 1:51 remaining, positioning Minnesota to close out the victory.\n\nFred VanVleet shot 12.6 percentage points above expectation in the loss, converting at a higher rate than an average NBA player would be expected to convert his tracked shot opportunities. Kevin Durant drew above-expected defensive pressure, recording Average Gravity of 12.4 as opponents focused their attention on the Rockets' leading scorer. Jaden McDaniels produced a Total Leverage of 3.4 for Minnesota, contributing across multiple facets of the game in the Timberwolves' road victory."}},"defining_moments":{"gameId":"0022600181","moduleType":"defining_moments","definingMoments":[{"guid":"fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2","rank":1,"title":"Jonathan Kuminga Finishes the Layup","summary":"Jonathan Kuminga finished off the tip layup, and the Timberwolves led 111–104 with 1:51 remaining in the fourth.","category":"Scoring","eventNum":695,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/695/fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/695/fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2_1280x720.mp4","playerId":1630228,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/695/fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/695/fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/695/fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2.m3u8","largeDuration":11133,"smallDuration":11133,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/695/fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2_1280x720.jpg","mediumDuration":11133,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/695/fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/695/fc81d1d5-d74e-67e9-5bf9-9f4d887b1ca2_960x540.jpg"},{"guid":"47b9efc8-192f-47ea-e151-a96ee5600acd","rank":2,"title":"Fred VanVleet Connects on the Jumper","summary":"Fred VanVleet knocked down the fadeaway jump shot, and the Timberwolves led 106–104 with 2:58 remaining in the fourth.","category":"Scoring","eventNum":683,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/683/47b9efc8-192f-47ea-e151-a96ee5600acd_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/683/47b9efc8-192f-47ea-e151-a96ee5600acd_1280x720.mp4","playerId":1627832,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/04/0022600181/683/47b9efc8-192f-47ea-e151-a96ee5600acd_320x180.mp4","med