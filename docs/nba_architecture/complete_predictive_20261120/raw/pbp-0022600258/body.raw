mem-vs-cle-0022600258","play-by-play"]},"istGroup":{},"banner":{"desktop":"https://cdn.nba.com/manage/2025/09/header-inside-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600258","gameCode":"20261118/MEMCLE","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-19T00:00:00Z","gameEt":"2026-11-18T19:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-19T00:10:26Z","actualEndTimeUTC":"2026-11-19T02:32:04Z","gameDurationSeconds":8498,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612739,"teamName":"Cavaliers","teamCity":"Cleveland","teamTricode":"CLE","teamSlug":"cavaliers","wins":8,"losses":8,"score":121,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":37},{"period":2,"periodType":"REGULAR","score":35},{"period":3,"periodType":"REGULAR","score":27},{"period":4,"periodType":"REGULAR","score":22}],"starters":[{"personId":201935,"position":"PG","lastName":"Harden","firstName":"James","status":"Confirmed"},{"personId":1626209,"position":"PF","lastName":"Hezonja","firstName":"Mario","status":"Confirmed"},{"personId":1628378,"position":"SG","lastName":"Mitchell","firstName":"Donovan","status":"Confirmed"},{"personId":1628386,"position":"C","lastName":"Allen","firstName":"Jarrett","status":"Confirmed"},{"personId":1642878,"position":"SF","lastName":"Proctor","firstName":"Tyrese","status":"Confirmed"}]},"awayTeam":{"teamId":1610612763,"teamName":"Grizzlies","teamCity":"Memphis","teamTricode":"MEM","teamSlug":"grizzlies","wins":11,"losses":4,"score":124,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":30},{"period":2,"periodType":"REGULAR","score":41},{"period":3,"periodType":"REGULAR","score":29},{"period":4,"periodType":"REGULAR","score":24}],"starters":[{"personId":1641744,"position":"C","lastName":"Edey","firstName":"Zach","status":"Confirmed"},{"personId":1642285,"position":"PG","lastName":"Spencer","firstName":"Cam","status":"Confirmed"},{"personId":1642377,"position":"SF","lastName":"Wells","firstName":"Jaylen","status":"Confirmed"},{"personId":1642907,"position":"SG","lastName":"Coward","firstName":"Cedric","status":"Confirmed"},{"personId":1643409,"position":"PF","lastName":"Boozer","firstName":"Cameron","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Memphis Grizzlies Earn the Win","body":"The Memphis Grizzlies defeated the Cleveland Cavaliers 124-121. Donovan Mitchell led the Cavaliers with 34 points on 14-for-27 shooting, while Jarrett Allen added 19 points and 9 rebounds. For Memphis, Cam Spencer erupted for 26 points on 9-for-11 shooting with 7 assists, and Taylor Hendricks contributed 18 points on 6-for-7 from the field. The Memphis Grizzlies paired an edge in bench scoring with an edge in free-throw opportunities over the Cleveland Cavaliers.\n\nThe Cavaliers built early momentum, going on a 9–0 run during the second quarter to establish control. Memphis responded with a decisive 14–6 run in the third quarter that shifted the game's trajectory. The contest remained tightly contested throughout, with both teams trading baskets down the stretch. Zach Edey made a hook shot that left the Cavaliers leading 119–118 with 2:25 remaining in the fourth, but Memphis found the final answer to secure the victory.\n\nSpencer's shooting efficiency stood out as a key factor in the Grizzlies' win, converting at 38.9 percentage points above expectation. James Harden drew above-expected defensive pressure for Cleveland, recording Average Gravity of 13.4, while Mitchell's overall impact was substantial with Total Leverage of 7.4, though the Cavaliers ultimately fell short in this close contest."}},"defining_moments":{"gameId":"0022600258","moduleType":"defining_moments","definingMoments":[{"guid":"3322dee1-d343-121b-2327-10e57f0303ed","rank":1,"title":"Zach Edey in the Spotlight","summary":"Cameron Boozer found Zach Edey, who converted the hook shot, and the Cavaliers led 119–118 with 2:25 remaining in the fourth.","category":"Scoring","eventNum":669,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/18/0022600258/669/3322dee1-d343-121b-2327-10e57f0303ed_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/18/0022600258/669/3322dee1-d343-121b-2327-10e57f0303ed_1280x720.mp4","playerId":1641744,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/18/0022600258/669/3322dee1-d343-121b-2327-10e57f0303ed_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/18/0022600258/669/3322dee1-d343-121b-2327-10e57f0303ed_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/18/0022600258/669/3322dee1-d343-121b-2327-10e57f0303ed.m3u8","largeDuration":9733,"smallDuration":9733,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/18/0022600258/669/3322dee1-d343-121b-2327-10e57f0303ed_1280x720.jpg","mediumDuration":9733,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/18/0022600258/669/3322dee1-d343-121b-2327-10e57f0303ed_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/p