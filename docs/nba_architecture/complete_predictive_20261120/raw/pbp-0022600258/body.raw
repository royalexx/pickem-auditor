isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"SUB: Thomas FOR Allen","actionType":"Substitution","subType":"","videoAvailable":0,"shotValue":0,"actionId":502},{"actionNumber":750,"clock":"PT00M02.30S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1642907,"playerName":"Coward","playerNameI":"C. Coward","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"121","scoreAway":"124","pointsTotal":245,"location":"v","description":"Coward Free Throw 2 of 2 (20 PTS)","actionType":"Free Throw","subType":"Free Throw 2 of 2","videoAvailable":1,"shotValue":0,"actionId":503},{"actionNumber":754,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"CAVALIERS Heave","actionType":"Heave","subType":"Team Field Goal Attempt","videoAvailable":0,"shotValue":0,"actionId":504},{"actionNumber":755,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":1610612739,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"CAVALIERS Rebound","actionType":"Rebound","subType":"Unknown","videoAvailable":0,"shotValue":0,"actionId":505},{"actionNumber":756,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"121","scoreAway":"124","pointsTotal":245,"location":"","description":"End of 4th Period (9:32 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":506}],"source":"hanaV3"},"headline":"Grizzlies outlast Cavs","heroImage":"https://cdn.nba.com/manage/2026/11/GettyImages-2305251939-Cropped-scaled.jpg","story":{"header":{"headline":"Grizzlies beat Cavaliers 124-121 for a franchise-record 8th straight road win","byline":"By JOE REEDY","bytitle":"AP Sports Writer"},"date":"2026-11-19T10:13:43","content":["CLEVELAND (AP)  Cam Spencer scored 26 points, Taylor Hendricks added 20, including a key pair of free throws with 2.3 seconds remaining, and the Memphis Grizzlies set a franchise record with their eighth straight road win, defeating the Cleveland Cavaliers 124-121 Wednesday night.","Rookie Cameron Boozer had 18 points and seven rebounds, while Cedric Coward also scored 18. The Grizzlies surpassed their previous road mark of seven, set in 2010. It also doubles Memphis' previous best road start in a season.","Donovan Mitchell had 34 points for Cleveland, the first time this season he has had consecutive 30-point games. Jarrett Allen added 19 points and nine rebounds. The Cavaliers had won seven straight over the Grizzlies before losing to them for the first time since 2023.","Mitchell’s layup gave Cleveland a 119-116 lead with 2:43 remaining before Memphis closed the game on an 8-2 run. Boozer put the Grizzlies up for a good by making both free throws with 1:26 remaining for a 120-119 advantage.","The Cavaliers trailed 122-121 with 15.9 seconds remaining, but had a shot to win after Memphis' Jerami Grant received a five-second violation. Sam Merrill drove the lane and was fouled by Boozer with 6.6 seconds left, but missed both free throws. Hendricks got the rebound and raced up the floor before being fouled by Merrill.","The game saw 22 lead changes, including eight in the fourth quarter.","The Grizzlies were without point guard Ty Jerome, who leads the team in scoring at 25.4 points per game. He missed his third straight game due to right hip soreness.","Cleveland was missing starting forwards Peyton Watson (low back contusion) and Evan Mobley (left big toe sprain). Coach Kenny Atkinson said Watson was still feeling “sluggish,” after he was injured in a violent mid-air collision with Bulls center Jalen Smith on Monday.","Grizzlies: Host Golden State on Thursday.","Cavaliers: Host Indiana in an NBA Cup game Friday.","---"],"storyType":"recap"},"postId":2439798,"view":{"id":"play-by-play","label":"Play-By-Play"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"MEM @ CLE, 2026-11-18","gameID":"0022600258","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"SiriusXM;DAZN-CLE;WTAM/WMMS/WJMO;DAZN-MEM;WMFS","venue":"Rocket Arena, Cleveland, OH","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2440646,"title":"Highlights From Donovan Mitchell 34-Point Game","shortTitle":"","permalink":"https://www.nba.com/watch/video/highlights-from-donovan-mitchell-34-point-game-4?plsrc=nba\u0026game-highlights=0022600258","videoDuration":"02:47","featuredImage":"https://cdn.nba.com/manage/2026/11/60c207fe-af81-4966-8363-65a5c2bee11b_0-2.jpg","entitlements":"","videoFranchisesName":{"25-pts-gm":"25+ Points in a Game"}},{"id":2440642,"title":"Highlights From Cam Spencer 26-Point Game","shortTitle":"","permalink":"https://www.nba.com/watch/video/highlights-from-cam-spencer-26-point-game?plsrc=nba\u0026game-highlights=0022600258","videoDuration":"01:41","featuredImage":"https://cdn.nba.com/manage/2026/11/82a316a5-2b72-4ab4-a22a-d895f2e17a20_0.jpg","entitlements":"","videoFranchisesName":{"25-pts-gm":"25+ Points in a Game"}},{"id":2440622,"title":"Cleveland Cavaliers vs. Memphis Grizzlies - 4th Quarter Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/cleveland-cavaliers-vs-memphis-grizzlies-4th-quarter-highlights-2?plsrc=nba\u0026game-highlights=0022600258","videoDuration":"01:30","featuredImage":"https://cdn.nba.com/manage/2026/11/60c207fe-af81-4966-8363-65a5c2bee11b_