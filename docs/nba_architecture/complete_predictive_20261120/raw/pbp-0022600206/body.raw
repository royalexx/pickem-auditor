,28800],\"isCustomRange\":false}"},"initialQueryParams":{"props":["mem-vs-tor-0022600206","play-by-play"]},"istGroup":{},"banner":{"desktop":"https://cdn.nba.com/manage/2025/09/header-inside-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600206","gameCode":"20261109/MEMTOR","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-10T00:30:00Z","gameEt":"2026-11-09T19:30:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-10T00:42:17Z","actualEndTimeUTC":"2026-11-10T02:52:59Z","gameDurationSeconds":7842,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612761,"teamName":"Raptors","teamCity":"Toronto","teamTricode":"TOR","teamSlug":"raptors","wins":5,"losses":5,"score":102,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":26},{"period":2,"periodType":"REGULAR","score":27},{"period":3,"periodType":"REGULAR","score":28},{"period":4,"periodType":"REGULAR","score":21}],"starters":[{"personId":203937,"position":"PF","lastName":"Anderson","firstName":"Kyle","status":"Confirmed"},{"personId":1627751,"position":"C","lastName":"Poeltl","firstName":"Jakob","status":"Confirmed"},{"personId":1629628,"position":"SF","lastName":"Barrett","firstName":"RJ","status":"Confirmed"},{"personId":1642266,"position":"SG","lastName":"Walter","firstName":"Ja'Kobe","status":"Confirmed"},{"personId":1642347,"position":"PG","lastName":"Shead","firstName":"Jamal","status":"Confirmed"}]},"awayTeam":{"teamId":1610612763,"teamName":"Grizzlies","teamCity":"Memphis","teamTricode":"MEM","teamSlug":"grizzlies","wins":7,"losses":3,"score":118,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":0,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":25},{"period":2,"periodType":"REGULAR","score":34},{"period":3,"periodType":"REGULAR","score":30},{"period":4,"periodType":"REGULAR","score":29}],"starters":[{"personId":1629660,"position":"PG","lastName":"Jerome","firstName":"Ty","status":"Confirmed"},{"personId":1641744,"position":"C","lastName":"Edey","firstName":"Zach","status":"Confirmed"},{"personId":1642377,"position":"SF","lastName":"Wells","firstName":"Jaylen","status":"Confirmed"},{"personId":1642907,"position":"SG","lastName":"Coward","firstName":"Cedric","status":"Confirmed"},{"personId":1643409,"position":"PF","lastName":"Boozer","firstName":"Cameron","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"team_top_sets","order":5},{"moduleType":"defensive_spotlight","order":6},{"moduleType":"leverage_spotlight","order":7}],"gameOverview":{"title":"The Memphis Grizzlies Earn the Win","body":"The Memphis Grizzlies defeated the Toronto Raptors 118-102. Ty Jerome led the Memphis Grizzlies with 27 points on 9-for-19 shooting, including 5-for-11 from three, while Cameron Boozer added 22 points and 8 assists on 9-for-16 from the field. For Toronto, Jamal Shead scored 20 points with 11 assists, and RJ Barrett contributed 19 points, though Barrett shot 7-for-21 from the field.\n\nThe Raptors mounted a 17–5 run in the third quarter to stay competitive, but Memphis responded decisively in the fourth. The Grizzlies built momentum with a 22–7 run over the final stretch of the game, pulling away down the stretch. Zach Edey's hook shot made the score 113–97 with 3:49 remaining, effectively sealing the victory. The Memphis Grizzlies got more scoring support from their bench than the Toronto Raptors.\n\nRJ Barrett drew above-expected defensive pressure with an Average Gravity of 16.3, while Jakob Poeltl shot 13.5 percentage points above expectation. Jerami Grant recorded Total Leverage of 3.9 for Memphis, reflecting his overall impact across multiple facets of the game."}},"defining_moments":{"gameId":"0022600206","moduleType":"defining_moments","definingMoments":[{"guid":"b22872b9-957c-6c68-e8d7-d27603bd6ca8","rank":1,"title":"Zach Edey in the Spotlight","summary":"Cameron Boozer found Zach Edey, who converted the hook shot, and the Grizzlies led 113–97 with 3:49 remaining in the fourth.","category":"Scoring","eventNum":675,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/09/0022600206/675/b22872b9-957c-6c68-e8d7-d27603bd6ca8_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/09/0022600206/675/b22872b9-957c-6c68-e8d7-d27603bd6ca8_1280x720.mp4","playerId":1641744,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/09/0022600206/675/b22872b9-957c-6c68-e8d7-d27603bd6ca8_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/09/0022600206/675/b22872b9-957c-6c68-e8d7-d27603bd6ca8_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/09/0022600206/675/b22872b9-957c-6c68-e8d7-d27603bd6ca8.m3u8","largeDuration":10433,"smallDuration":10433,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/09/0022600206/675/b22872b9-957c-6c68-e8d7-d27603bd6ca8_1280x720.jpg","mediumDuration":10433,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/09/0022600206/675/b22872b9-957c-6c68-e8d7-d27603bd6ca8_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/09/0022600206/675/b22872b9-957c-6c68-e8d7-d27603bd6ca8_960x540.jpg"},{"guid":"88da5546-1a00-fb39-667a-4dff45d2a515","rank":