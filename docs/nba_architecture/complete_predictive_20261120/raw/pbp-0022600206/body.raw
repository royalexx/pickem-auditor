:"","scoreAway":"","pointsTotal":0,"location":"v","description":"SUB: Prosper FOR Jerome","actionType":"Substitution","subType":"","videoAvailable":0,"shotValue":0,"actionId":488},{"actionNumber":728,"clock":"PT00M48.10S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1641744,"playerName":"Edey","playerNameI":"Z. Edey","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"SUB: Jackson FOR Edey","actionType":"Substitution","subType":"","videoAvailable":0,"shotValue":0,"actionId":489},{"actionNumber":729,"clock":"PT00M29.40S","period":4,"teamId":1610612761,"teamTricode":"TOR","personId":1642918,"playerName":"Martin","playerNameI":"A. Martin","xLegacy":-6,"yLegacy":-21,"shotDistance":2,"shotResult":"Missed","isFieldGoal":1,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"MISS Martin 2' Driving Reverse Layup","actionType":"Missed Shot","subType":"Driving Reverse Layup Shot","videoAvailable":1,"shotValue":2,"actionId":490},{"actionNumber":730,"clock":"PT00M29.40S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1641707,"playerName":"Hendricks","playerNameI":"T. Hendricks","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Hendricks REBOUND (Off:1 Def:2)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":491},{"actionNumber":731,"clock":"PT00M06.00S","period":4,"teamId":0,"teamTricode":"","personId":1610612763,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Grizzlies Turnover: Shot Clock (T#18)","actionType":"Turnover","subType":"Shot Clock Turnover","videoAvailable":1,"shotValue":0,"actionId":492},{"actionNumber":732,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"102","scoreAway":"118","pointsTotal":220,"location":"","description":"End of 4th Period (9:53 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":493}],"source":"hanaV3"},"headline":"Jerome heater continues","heroImage":"https://cdn.nba.com/manage/2026/11/GettyImages-2303952733-scaled-e1794278233258.jpg","story":{"header":{"headline":"Jerome scores 27 points as Grizzlies improve to 5-0 on road by routing short-handed Raptors 118-102","byline":"By IAN HARRISON","bytitle":"Associated Press"},"date":"2026-11-09T22:26:07","content":["TORONTO (AP)  Ty Jerome scored 27 points, Cameron Boozer added 22 and the Memphis Grizzlies improved to 5-0 on the road this season by beating the short-handed Toronto Raptors 118-102 on Monday night.","Memphis is the only NBA team without a road loss this season. They’ve also won at Golden State, Sacramento, Utah and Portland.","Jerami Grant scored 17 points and Jaylen Wells had 14 as the Grizzlies snapped a three-game losing streak and won for the fifth time in six trips to Toronto.","Boozer had seven rebounds and eight assists. Zach Edey had eight points and nine rebounds in his lone regular-season visit to his hometown.","Memphis was without center Isaiah Stewart (right knee) for the second straight game. Grizzlies center Quinten Post left in the first quarter after being elbowed in the face while defending Jamison Battle’s drive to the basket.","Jamal Shead had 20 points and 11 assists for the Raptors, who played without three starters.","Kawhi Leonard (left knee) missed his sixth straight game, while Scottie Barnes (left groin) and Immanuel Quickley (right hamstring) each sat for the second straight.","The Raptors were also without reserve forward Collin Murray-Boyles, who sat out because of an illness.","RJ Barrett scored 19 points for Toronto. Battle and Jakob Poeltl each had 18 and Ja’Kobe Walter added 12.","The Raptors won their opening two games of the season but haven’t won back-to-back games since.","Grizzlies: Host Denver on Wednesday night.","Raptors: Host Boston on Wednesday night.","---","See AP’s full NBA coverage here"],"storyType":"recap"},"postId":2425968,"view":{"id":"play-by-play","label":"Play-By-Play"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"MEM @ TOR, 2026-11-09","gameID":"0022600206","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"SN/SN+;CJCL;SiriusXM;SN/SN+;CJCL;DAZN-MEM;WMFS","venue":"Scotiabank Arena, Toronto, ON","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2426425,"title":"Highlights From Ty Jerome 27-Point Game","shortTitle":"","permalink":"https://www.nba.com/watch/video/highlights-from-ty-jerome-27-point-game?plsrc=nba\u0026game-highlights=0022600206","videoDuration":"02:00","featuredImage":"https://cdn.nba.com/manage/2026/11/e757755a-1699-4c35-934f-fcff2e2fd0c3_0.jpg","entitlements":"","videoFranchisesName":{"25-pts-gm":"25+ Points in a Game"}},{"id":2426409,"title":"Toronto Raptors vs. Memphis Grizzlies - 2nd Half Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/toronto-raptors-vs-memphis-grizzlies-2nd-half-highlights?plsrc=nba\u0026game-highlights=0022600206","videoDuration":"01:30","featuredImage":"https://cdn.nba.com/manage/2026/11/7fbc7b47-e890-4483-8a1a-9ce359f1946c_0-3.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2426408,"title":"Toronto Raptors vs. Memphis Grizzlies - 4th Quarter Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/toronto-raptors-vs-memphis-grizzlies-4th-quarter-highlights-2?plsrc=nba\u0026game-highlights=0022600206","videoDuration":"01:29","featuredImage":"https://cdn.nba.com/manage/2026/11/b4870548-a732-4a53-baf1-8b2c7a460c6d_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2426406,"title":"RJ Barrett connects from deep","shortTitle":"","permalink":"https://www.nba.com/watch/video/rj-barrett-connects-from-deep-2?plsrc=nba\u0026game-highlights=0022600206","videoDuration":"00:12","featuredImage":"https://cdn.nba.com/manage/2026/11/ee33e558-8e92-42e1-8681-0191ccb5f88d_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2426377,"title":"Ty Jerome gets the 3 to fall","shortTitle":"","permalink":"https://www.nba.com/watch/video/ty-jerome-gets-the-3-to-fall-2?plsrc=nba\u0026game-highlights=0022600206","videoDuration":"00:23","featuredImage":"https://cdn.nba.com/manage/2026/11/9f9bd673-6b81-4583-8e50-3573c4e54657_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2426309,"title":"Toronto Raptors vs. Memphis Grizzlies - 3rd Quarter Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/toronto-raptors-vs-memphis-grizzlies-3rd-quarter-highlights-2?plsrc=nba\u0026game-highlights=0022600206","videoDuration":"01:29","featuredImage":"https://cdn.nba.com/manage/2026/11/7fbc7b47-e890-4483-8a1a-9ce359f1946c_0-2.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2426307,"title":"Jamison Battle with the slam","shortTitle":"","permalink":"https://www.nba.com/watch/video/jamison-battle-with-the-slam?plsrc=nba\u0026game-highlights=0022600206","videoDuration":"00:09","featuredImage":"https://cdn.nba.com/manage/2026/11/5d73d8c2-96b9-4dc3-a4e9-e17dbbf41da2_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2426305,"title":"Cameron