6-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-05T01:10:30Z","actualEndTimeUTC":"2026-11-05T03:22:35Z","gameDurationSeconds":7925,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612763,"teamName":"Grizzlies","teamCity":"Memphis","teamTricode":"MEM","teamSlug":"grizzlies","wins":6,"losses":2,"score":103,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":0,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":24},{"period":2,"periodType":"REGULAR","score":28},{"period":3,"periodType":"REGULAR","score":30},{"period":4,"periodType":"REGULAR","score":21}],"starters":[{"personId":1629660,"position":"PG","lastName":"Jerome","firstName":"Ty","status":"Confirmed"},{"personId":1641744,"position":"C","lastName":"Edey","firstName":"Zach","status":"Confirmed"},{"personId":1642377,"position":"SF","lastName":"Wells","firstName":"Jaylen","status":"Confirmed"},{"personId":1642907,"position":"SG","lastName":"Coward","firstName":"Cedric","status":"Confirmed"},{"personId":1643409,"position":"PF","lastName":"Boozer","firstName":"Cameron","status":"Confirmed"}]},"awayTeam":{"teamId":1610612754,"teamName":"Pacers","teamCity":"Indiana","teamTricode":"IND","teamSlug":"pacers","wins":3,"losses":6,"score":107,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":0,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":32},{"period":2,"periodType":"REGULAR","score":22},{"period":3,"periodType":"REGULAR","score":26},{"period":4,"periodType":"REGULAR","score":27}],"starters":[{"personId":1627783,"position":"PF","lastName":"Siakam","firstName":"Pascal","status":"Confirmed"},{"personId":1627826,"position":"C","lastName":"Zubac","firstName":"Ivica","status":"Confirmed"},{"personId":1629614,"position":"PG","lastName":"Nembhard","firstName":"Andrew","status":"Confirmed"},{"personId":1630174,"position":"SF","lastName":"Nesmith","firstName":"Aaron","status":"Confirmed"},{"personId":1643552,"position":"SG","lastName":"Smith","firstName":"Braden","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Indiana Pacers Earn the Win","body":"The Indiana Pacers defeated the Memphis Grizzlies 107-103. Andrew Nembhard led the Pacers with 22 points on 8-for-15 shooting, adding 4 assists, while Pascal Siakam contributed 20 points on an efficient 8-for-13 from the field. For Memphis, Cedric Coward and Ty Jerome each scored 23 points, with Coward grabbing 9 rebounds and Jerome shooting 10-for-20 from the floor.\n\nIndiana built momentum early, going on a 15–3 run spanning the late first quarter into the second quarter to establish control. Memphis responded with a 22–8 run of their own in the second quarter, keeping the contest competitive throughout. The game remained tightly contested down the stretch, with Aaron Nesmith's three-pointer with 14.6 seconds remaining giving the Pacers a 107–103 lead they would not relinquish.\n\nSiakam shot 16.4 percentage points above expectation, converting at a notably higher rate than expected given his shot difficulty. Jerome drew above-expected defensive pressure, recording an Average Gravity of 22.0, while Nembhard's overall impact across all areas registered a Total Leverage of 5.3 in the close contest."}},"defining_moments":{"gameId":"0022600178","moduleType":"defining_moments","definingMoments":[{"guid":"c174bfcb-1c91-c355-bc53-03b0a0c28cc6","ra