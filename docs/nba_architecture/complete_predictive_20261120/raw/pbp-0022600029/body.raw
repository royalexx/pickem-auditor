AR","score":28},{"period":2,"periodType":"REGULAR","score":21},{"period":3,"periodType":"REGULAR","score":27},{"period":4,"periodType":"REGULAR","score":21}],"starters":[{"personId":1629660,"position":"PG","lastName":"Jerome","firstName":"Ty","status":"Confirmed"},{"personId":1641744,"position":"C","lastName":"Edey","firstName":"Zach","status":"Confirmed"},{"personId":1642377,"position":"SF","lastName":"Wells","firstName":"Jaylen","status":"Confirmed"},{"personId":1642907,"position":"SG","lastName":"Coward","firstName":"Cedric","status":"Confirmed"},{"personId":1643409,"position":"PF","lastName":"Boozer","firstName":"Cameron","status":"Confirmed"}]},"awayTeam":{"teamId":1610612760,"teamName":"Thunder","teamCity":"Oklahoma City","teamTricode":"OKC","teamSlug":"thunder","wins":7,"losses":2,"score":128,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":1,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":35},{"period":2,"periodType":"REGULAR","score":36},{"period":3,"periodType":"REGULAR","score":27},{"period":4,"periodType":"REGULAR","score":30}],"starters":[{"personId":1628392,"position":"C","lastName":"Hartenstein","firstName":"Isaiah","status":"Confirmed"},{"personId":1628983,"position":"PG","lastName":"Gilgeous-Alexander","firstName":"Shai","status":"Confirmed"},{"personId":1629026,"position":"PF","lastName":"Williams","firstName":"Kenrich","status":"Confirmed"},{"personId":1642272,"position":"SG","lastName":"McCain","firstName":"Jared","status":"Confirmed"},{"personId":1642349,"position":"SF","lastName":"Mitchell","firstName":"Ajay","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Oklahoma City Thunder Earn the Win","body":"The Oklahoma City Thunder defeated the Memphis Grizzlies 128-97. Ajay Mitchell led the Oklahoma City Thunder with 35 points on 14-for-20 shooting, including 4-for-7 from three-point range, while adding 5 assists. Shai Gilgeous-Alexander contributed 28 points on 11-for-22 shooting with 4 assists for Oklahoma City. For Memphis, Ty Jerome scored 21 points with 5 assists on 7-for-14 shooting, and Zach Edey added 14 points and 6 rebounds on 3-for-7 from the field.\n\nThe Grizzlies mounted an early push, going on a 10–2 run in the opening quarter to stay competitive. The Oklahoma City Thunder found far more offense inside, outscoring the Memphis Grizzlies in the paint. The Thunder built their lead methodically, with Mitchell's shooting touch providing consistent scoring throughout. Late in the fourth quarter, Oklahoma City sealed the outcome with a 17–2 run, extending their advantage and putting the game out of reach. The Memphis Grizzlies had more free-throw opportunities than the Oklahoma City Thunder.\n\nMitchell's efficiency stood out in the final statistics. He shot 21 percentage points above expectation, demonstrating his ability to convert at a higher rate than an average NBA player would be expected to achieve against the same tracked shot opportunities. Gilgeous-Alexander drew above-expected defensive pressure, recording Average Gravity of 25.3, while Mitchell's overall impact was reflected in his Total Leverage of 3.2."}},"defining_moments":{"gameId":"0022600029","moduleType":"defining_moments","definingMoments":[{"guid":"40439c42-4e42-7d3c-8100-40a6585a8a34","rank":1,"title":"Ajay Mitchell Delivers a Triple","summary":"Ajay Mitchell knocked down a three-pointer off the assist from Shai Gilgeous-Alexander, making it 64–46 in favor of the Thunder with 1:45 remaining in the second.","category":"Scoring","eventNum":332,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/06/0022600029/332/40439c42-4e42-7d3c-8100-40a6585a8a34_hls_3500kbps_1280x720.m3u8"