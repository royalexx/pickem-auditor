"endTime":14400,"startPeriod":1,"endPeriod":2,"json":"{\"rangeType\":1,\"startPeriod\":1,\"endPeriod\":2,\"startRange\":0,\"endRange\":14400}"},{"RangeType":1,"lp":0,"isOT":false,"text":"2nd Half","val":"2ndHalf","startTime":14400,"endTime":28800,"startPeriod":3,"endPeriod":4,"json":"{\"rangeType\":1,\"startPeriod\":3,\"endPeriod\":4,\"startRange\":14400,\"endRange\":28800}"}],"boxscoreParams":{"defaultRangeString":"0-28800","initialBoxscoreCacheKey":"{\"resource\":\"traditional\",\"gameId\":\"0022600254\",\"rangePeriod\":\"{\\\"rangeType\\\":0,\\\"startPeriod\\\":0,\\\"endPeriod\\\":0,\\\"startRange\\\":0,\\\"endRange\\\":28800}\",\"rangeTime\":[0,28800],\"isCustomRange\":false}"},"initialQueryParams":{"props":["por-vs-min-0022600254","box-score"]},"istGroup":{},"banner":{"desktop":"https://cdn.nba.com/manage/2025/09/header-inside-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600254","gameCode":"20261117/PORMIN","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-18T01:00:00Z","gameEt":"2026-11-17T20:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-18T01:10:40Z","actualEndTimeUTC":"2026-11-18T03:36:56Z","gameDurationSeconds":8776,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612750,"teamName":"Timberwolves","teamCity":"Minnesota","teamTricode":"MIN","teamSlug":"timberwolves","wins":11,"losses":4,"score":106,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":2,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":29},{"period":2,"periodType":"REGULAR","score":20},{"period":3,"periodType":"REGULAR","score":30},{"period":4,"periodType":"REGULAR","score":27}],"starters":[{"personId":203497,"position":"C","lastName":"Gobert","firstName":"Rudy","status":"Confirmed"},{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"},{"personId":1642262,"position":"PF","lastName":"Williams","firstName":"Cody","status":"Confirmed"}]},"awayTeam":{"teamId":1610612757,"teamName":"Trail Blazers","teamCity":"Portland","teamTricode":"POR","teamSlug":"blazers","wins":9,"losses":5,"score":105,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":17},{"period":2,"periodType":"REGULAR","score":31},{"period":3,"periodType":"REGULAR","score":31},{"period":4,"periodType":"REGULAR","score":26}],"starters":[{"personId":203081,"position":"PG","lastName":"Lillard","firstName":"Damian","status":"Confirmed"},{"personId":1631321,"position":"SF","lastName":"Cissoko","firstName":"Sidy","status":"Confirmed"},{"personId":1641739,"position":"PF","lastName":"Camara","firstName":"Toumani","status":"Confirmed"},{"personId":1642270,"position":"C","lastName":"Clingan","firstName":"Donovan","status":"Confirmed"},{"personId":1643257,"position":"SG","lastName":"Kent","firstName":"Jayson","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Minnesota Timberwolves Earn the Win","body":"The Minnesota Timberwolves defeated the Portland Trail Blazers 106-105. Ayo Dosunmu led the Timberwolves with 30 points on 11-for-19 shooting, including 7-for-11 from three-point range, while adding 4 rebounds and 5 assists. Jaden McDaniels contributed 22 points, 5 rebounds and 4 assists on 10-for-16 from the field. For Portland, Damian Lillard scored 25 points with 5 assists, and Jrue Holiday added 23 points with 6 assists and 5 rebounds, though Holiday shot 7-for-19 from the field.\n\nMinnesota built momentum early, going on a 16–2 run in the first quarter to establish control. Portland responded with a 12–0 run in the third quarter to stay competitive. The contest remained tightly contested throughout, with the Timberwolves ultimately prevailing in a one-possession finish. Jaden McDaniels scored on a layup with 0:02.6 remaining in the fourth, making it 106–105 in favor of Minnesota. The Minnesota Timberwolves got more second-chance scoring than the Portland Trail Blazers.\n\nDosunmu shot 12.5 percentage points above expectation, converting at a rate significantly higher than an average NBA player would be expected to achieve on the same tracked opportunities. Jaden McDaniels drew above-expected defensive pressure, recording an Average Gravity of 13.0 as opponents focused their efforts on him. For Portland, Jrue Holiday's Total Leverage of 7.2 reflected his overall impact across multiple facets of the game."}},"defining_moments":{"gameId":"0022600254","moduleType":"defining_moments","definingMoments":[{"guid":"7952a2e9-8bd2-d45c-4073-a2dbfd61603c","rank":1,"title":"Jaden McDaniels Finishes the Layup","summary":"Ayo Dosunmu found Jaden McDaniels, who converted the running layup, and the Timberwolves led 106–105 with 2.6 seconds remaining in the fourth.","category":"Scoring","eventNum":737,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/737/7952a2e9-8bd2-d45c-4073-a2dbfd61603c_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/737/7952a2e9-8bd2-d45c-4073-a2dbfd61603c_1280x720.mp4","playerId":1630183,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/737/7952a2e9-8bd2-d45c-4073-a2dbfd61603c_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/737/7952a2e9-8bd2-d45c-4073-a2dbfd61603c_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/737/7952a2e9-8bd2-d45c-4073-a2dbfd61603c.m3u8","largeDuration":11166,"smallDuration":11166,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/737/7952a2e9-8bd2-d45c-4073-a2dbfd61603c_1280x720.jpg","mediumDuration":11166,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/737/7952a2e9-8bd2-d45c-4073-a2dbfd61603c_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/737/7952a2e9-8bd2-d45c-4073-a2dbfd61603c_960x540.jpg"},{"guid":"c48a8fbf-15e9-f888-e696-2edd3dfa88b4","rank":2,"title":"Toumani Camara Misses the Layup","summary":"Toumani Camara's layup came up short with 0.4 seconds left in the fourth, and the Timberwolves led 106–105.","category":"Defense","eventNum":745,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/745/c48a8fbf-15e9-f888-e696-2edd3dfa88b4_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/745/c48a8fbf-15e9-f888-e696-2edd3dfa88b4_1280x720.mp4","playerId":1641739,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/745/c48a8fbf-15e9-f888-e696-2edd3dfa88b4_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/745/c48a8fbf-15e9-f888-e696-2edd3dfa88b4_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/17/0022600254/745/c48a8fbf-15e9-f888-e696-2edd3dfa88b4.m3u8","largeDuration":14433,"smallDuration":14433,"largeThumbnail":"https://videos.nba.com/nba/pbp/medi