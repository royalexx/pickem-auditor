period":1,"periodType":"REGULAR","score":34},{"period":2,"periodType":"REGULAR","score":33},{"period":3,"periodType":"REGULAR","score":36},{"period":4,"periodType":"REGULAR","score":30}],"starters":[{"personId":203497,"position":"C","lastName":"Gobert","firstName":"Rudy","status":"Confirmed"},{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630228,"position":"PF","lastName":"Kuminga","firstName":"Jonathan","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"}]},"awayTeam":{"teamId":1610612742,"teamName":"Mavericks","teamCity":"Dallas","teamTricode":"DAL","teamSlug":"mavericks","wins":7,"losses":5,"score":94,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":2,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":26},{"period":2,"periodType":"REGULAR","score":26},{"period":3,"periodType":"REGULAR","score":17},{"period":4,"periodType":"REGULAR","score":25}],"starters":[{"personId":202681,"position":"PG","lastName":"Irving","firstName":"Kyrie","status":"Confirmed"},{"personId":1628997,"position":"SF","lastName":"Martin","firstName":"Caleb","status":"Confirmed"},{"personId":1629023,"position":"PF","lastName":"Washington","firstName":"P.J.","status":"Confirmed"},{"personId":1629655,"position":"C","lastName":"Gafford","firstName":"Daniel","status":"Confirmed"},{"personId":1642843,"position":"SG","lastName":"Flagg","firstName":"Cooper","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Minnesota Timberwolves Earn the Win","body":"The Minnesota Timberwolves defeated the Dallas Mavericks 133-94. Bones Hyland led the Timberwolves with 24 points on 7-for-10 shooting and 5-for-6 from three-point range, adding 8 assists and 3 rebounds. LaMelo Ball contributed 22 points, 9 assists and 3 rebounds while shooting 8-for-14 from the field and 6-for-10 from beyond the arc. For the Mavericks, Zaccharie Risacher scored 22 points on 9-for-14 shooting with 6 rebounds, and Naji Marshall added 13 points.\n\nThe Mavericks mounted an 11–2 run in the second quarter but could not sustain momentum as the Timberwolves took control. Minnesota's defense tightened in the third quarter, where the Timberwolves went on a 30–8 run to pull away decisively. LaMelo Ball hit a three-pointer to make it 70–53 in favor of the Timberwolves with 11:17 remaining in the third, exemplifying Minnesota's offensive rhythm during that stretch. The Minnesota Timberwolves paired a substantial advantage in paint scoring with an edge in second-chance scoring over the Dallas Mavericks.\n\nLaMelo Ball shot 14.4 percentage points above expectation, converting at a significantly higher rate than an average NBA player would be expected to achieve on the same tracked shot opportunities. Kyrie Irving drew above-expected defensive pressure for Dallas, recording Average Gravity of 11.3. Bones Hyland's overall impact was substantial, posting Total Leverage of 2.6 as the Timberwolves dominated the contest."}},"defining_moments":{"gameId":"0022600229","moduleType":"defining_moments","definingMoments":[{"guid":"17d363b9-644a-924e-bce6-112ff1e0e365","rank":1,"title":"LaMelo Ball Delivers a Triple","summary":"LaMelo Ball knocked down a three-pointer assisted by Jonathan Kuminga, making it 70–53 in favor of the Timberwolves with 11:17 remaining in the third.","category":"Scoring","eventNum":362,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/12/0022600229/362/17d363b9-644a-924e-bce6-112ff1e0e365_hls_3500kbps_1280x720.m3u8","la