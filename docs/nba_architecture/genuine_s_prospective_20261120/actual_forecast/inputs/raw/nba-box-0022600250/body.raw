4)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":543},{"actionNumber":751,"clock":"PT00M21.50S","period":4,"teamId":1610612750,"teamTricode":"MIN","personId":1642389,"playerName":"Pullin","playerNameI":"Z. Pullin","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"Pullin S.FOUL (P1.PN) (E.Dalen)","actionType":"Foul","subType":"Shooting","videoAvailable":1,"shotValue":0,"actionId":544},{"actionNumber":753,"clock":"PT00M21.50S","period":4,"teamId":1610612757,"teamTricode":"POR","personId":1642910,"playerName":"Tonje","playerNameI":"J. Tonje","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"106","scoreAway":"97","pointsTotal":203,"location":"v","description":"Tonje Free Throw 1 of 2 (6 PTS)","actionType":"Free Throw","subType":"Free Throw 1 of 2","videoAvailable":1,"shotValue":0,"actionId":545},{"actionNumber":754,"clock":"PT00M21.50S","period":4,"teamId":1610612757,"teamTricode":"POR","personId":1642910,"playerName":"Tonje","playerNameI":"J. Tonje","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"106","scoreAway":"98","pointsTotal":204,"location":"v","description":"Tonje Free Throw 2 of 2 (7 PTS)","actionType":"Free Throw","subType":"Free Throw 2 of 2","videoAvailable":1,"shotValue":0,"actionId":546},{"actionNumber":755,"clock":"PT00M13.30S","period":4,"teamId":0,"teamTricode":"","personId":1610612750,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"TIMBERWOLVES Timeout: Regular (Full 6 Short 0)","actionType":"Timeout","subType":"Regular","videoAvailable":0,"shotValue":0,"actionId":547},{"actionNumber":756,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"106","scoreAway":"98","pointsTotal":204,"location":"","description":"End of 4th Period (10:29 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":548}],"source":"hanaV3"},"headline":"Shannon nets career-high 34","heroImage":"https://cdn.nba.com/manage/2026/11/GettyImages-2304994248-scaled-e1794886359622.jpg","story":{"header":{"headline":"Terrence Shannon Jr. scores career-high 34 points as Timberwolves beat Trail Blazers 106-98","byline":"By BRIAN HALL","bytitle":"Associated Press"},"date":"2026-11-16T22:48:25","content":["MINNEAPOLIS (AP)  Terrence Shannon Jr. scored 12 of his career-high 34 points in the second quarter as the Minnesota Timberwolves recovered from a slow start to beat the Portland Trail Blazers 106-98 on Monday night in the opener of a two-game set.","Rudy Gobert added 18 points and 15 rebounds for Minnesota, which was coming off a home loss to Chicago on Saturday night. Jaden McDaniels had 13 points for the Timberwolves, who got just six points on 2-of-13 shooting from LaMelo Ball after he went 7 for 25 against the Bulls.","Deni Avdija scored 27 points to lead Portland, which had won three in a row and has been playing well under coach Micah Nori, a former Minnesota assistant who made his return to Target Center. Donovan Clingan had 10 points, 10 rebounds and five blocks for the Trail Blazers as his size gave Minnesota trouble, particularly early.","Minnesota continues to thrive in the absence of star Anthony Edwards and didn’t have backup guard Jaylen Clark on Monday due to a right hamstring strain. Edwards has missed the past 10 games while recovering from arthroscopic knee surgery. Minnesota is 7-3 in those and had won five in a row before Saturday.","Shannon keyed a 21-9 run to end the second half for Minnesota, leading to a 59-51 halftime advantage. With Shannon taking control again early in the fourth, the Timberwolves extended their lead to 19 points and Nori emptied his bench with 7:28 left.","Shannon added six rebounds and three assists.","Avdija’s drives to the basket helped Portland build a 10-point advantage in the first half as 22 of the Blazers’ first 41 points came in the paint.","The teams meet again Tuesday night at Target Center.","---","See AP’s full NBA coverage here"],"storyType":"recap"},"postId":2436679,"view":{"id":"box-score","label":"Box Score"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"POR @ MIN, 2026-11-16","gameID":"0022600250","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"Sport5_Isr;Arena Sport;Videoland / Elta TV;SiriusXM;DAZN-MIN;WCCO;KUNP;KPOJ;DTC-POR","venue":"Target Center, Minneapolis, MN","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2437302,"title":"Highlights From Deni Avdija 27-Point Game","shortTitle":"","permalink":"https://www.nba.com/watch/video/highlights-from-deni-avdija-27-point-game-3?plsrc=nba\u0026game-highlights=0022600250","videoDuration":"02:32","featuredImage":"https://cdn.nba.com/manage/2026/11/f0a9ea86-1a48-44ce-adc7-42f1ab3f8c5a_0-1.jpg","entitlements":"","videoFranchisesName":{"25-pts-gm":"25+ Points in a Game"}},{"id":2437291,"title":"Minnesota Timberwolves vs. Portland Trail Blazers - 4th Quarter Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/minnesota-timberwolves-vs-portland-trail-blazers-4th-quarter-highlights-3?plsrc=nba\u0026game-highlights=0022600250","videoDuration":"01:22","featuredImage":"https://cdn.nba.com/manage/2026/11/af5d9ce0-3c81-42fb-a541-67d377484297_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2437272,"title":"Minnesota Timberwolves vs. Portland Trail Blazers - 2nd Half Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/minnesota-timberwolves-vs-portland-trail-blazers-2nd-half-highlights-3?plsrc=nba\u0026game-highlights=0022600250","videoDuration":"01:29","featuredImage":"https://cdn.nba.com/manage/2026/11/1988fe81-ac42-408b-9d13-43a19073781d_0-2.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2437265,"title":"Jayson Kent rises up for the dunk","shortTitle":"","permalink":"https://www.nba.com/watch/video/jayson-kent-rises-up-for-the-dunk-2?plsrc=nba\u0026game-highlights=0022600250","videoDuration":"00:13","featuredImage":"https://cdn.nba.com/manage/2026/11/c0175240-177e-46a4-a329-def7d4fba8eb_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2437255,"title":"John Tonje with the dunk","shortTitle":"","permalink":"https://www.nba.com/watch/video/john-tonje-with-the-dunk?plsrc=nba\u0026game-highlights=0022600250","videoDuration":"00:17","featuredImage":"https://cdn.nba.com/manage/2026/11/1af8e352-f097-4078-9a6f-dcc7a2ebae3a_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2437205,"title":"Rudy Gobert throws it down","shortTitle":"","permalink":"https://www.nba.com/watch/video/rudy-gobert-throws-it-down-41?plsrc=nba\u0026game-highlights=0022600250","videoDuration":"00:09","featuredImage":"https://cdn.nba.com/manage/2026/11/b3c10963-d543-41dc-9977-81a48f7541a2_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2437190,"title":"Terrence Shannon Jr. hits from way downtown","shortTitle":"","permalink":"https://www.nba.com/watch/video/terrence-shannon-jr-hits-from-way-downtown?plsrc=nba\u0026game-highlights=0022600250","videoDuration":"00:12","featuredImage":"https://cdn.nba.com/manage/2026/11/1fc9476b-b635-4c9f-9c9a-b4c81d7b0751_0.jpg","entitlements":"fr