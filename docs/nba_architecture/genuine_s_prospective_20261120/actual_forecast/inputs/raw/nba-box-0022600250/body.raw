riod\":4,\"startRange\":14400,\"endRange\":28800}"}],"boxscoreParams":{"defaultRangeString":"0-28800","initialBoxscoreCacheKey":"{\"resource\":\"traditional\",\"gameId\":\"0022600250\",\"rangePeriod\":\"{\\\"rangeType\\\":0,\\\"startPeriod\\\":0,\\\"endPeriod\\\":0,\\\"startRange\\\":0,\\\"endRange\\\":28800}\",\"rangeTime\":[0,28800],\"isCustomRange\":false}"},"initialQueryParams":{"props":["por-vs-min-0022600250","box-score"]},"istGroup":{},"banner":{"desktop":"https://cdn.nba.com/manage/2025/09/header-inside-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600250","gameCode":"20261116/PORMIN","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-17T01:00:00Z","gameEt":"2026-11-16T20:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-17T01:11:15Z","actualEndTimeUTC":"2026-11-17T03:28:50Z","gameDurationSeconds":8255,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612750,"teamName":"Timberwolves","teamCity":"Minnesota","teamTricode":"MIN","teamSlug":"timberwolves","wins":10,"losses":4,"score":106,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":2,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":26},{"period":2,"periodType":"REGULAR","score":33},{"period":3,"periodType":"REGULAR","score":28},{"period":4,"periodType":"REGULAR","score":19}],"starters":[{"personId":203497,"position":"C","lastName":"Gobert","firstName":"Rudy","status":"Confirmed"},{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630228,"position":"PF","lastName":"Kuminga","firstName":"Jonathan","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"}]},"awayTeam":{"teamId":1610612757,"teamName":"Trail Blazers","teamCity":"Portland","teamTricode":"POR","teamSlug":"blazers","wins":9,"losses":4,"score":98,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":26},{"period":2,"periodType":"REGULAR","score":25},{"period":3,"periodType":"REGULAR","score":22},{"period":4,"periodType":"REGULAR","score":25}],"starters":[{"personId":203081,"position":"PG","lastName":"Lillard","firstName":"Damian","status":"Confirmed"},{"personId":1630166,"position":"SG","lastName":"Avdija","firstName":"Deni","status":"Confirmed"},{"personId":1631321,"position":"SF","lastName":"Cissoko","firstName":"Sidy","status":"Confirmed"},{"personId":1641739,"position":"PF","lastName":"Camara","firstName":"Toumani","status":"Confirmed"},{"personId":1642270,"position":"C","lastName":"Clingan","firstName":"Donovan","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Minnesota Timberwolves Earn the Win","body":"The Minnesota Timberwolves defeated the Portland Trail Blazers 106-98. Terrence Shannon Jr led the Minnesota Timberwolves with 34 points on 8-for-11 shooting, including 3-for-4 from three-point range, while adding 6 assists and 3 rebounds. For Portland, Deni Avdija scored 27 points on 11-for-19 shooting with a 3-for-3 performance from three-point distance, grabbing 8 rebounds and dishing 4 assists. Jrue Holiday added 10 points for the Trail Blazers.\n\nThe Portland Trail Blazers built early momentum with a 12–0 run spanning from 10:37 to 7:45 in the first quarter, but Minnesota responded decisively down the stretch. The Timberwolves mounted a 13–5 run from 9:43 to 5:37 in the fourth quarter that proved decisive in securing the victory. The Minnesota Timberwolves paired a substantial advantage in free-throw opportunities with an edge in fast-break scoring over the Portland Trail Blazers. Rudy Gobert finished with a dunk, making it 98–79 in favor of the Timberwolves with 7:42 remaining in the fourth, extending Minnesota's control in the final minutes.\n\nTerrence Shannon Jr shot 23 percentage points above expectation, converting at a significantly higher rate than expected on his efficient game. Jonathan Kuminga drew above-expected defensive pressure with an Average Gravity of 9.6, while Donovan Clingan recorded Total Leverage of 3.0 for Portland."}},"defining_moments":{"gameId":"0022600250","moduleType":"defining_moments","definingMoments":[{"guid":"33819269-e3a3-a449-64fb-51749c82d9ca","rank":1,"title":"Rudy Gobert Throws It Down","summary":"Trey Lyles found Rudy Gobert at the rim, and the Timberwolves led 98–79 with 7:42 remaining in the fourth.","category":"Scoring","eventNum":614,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600250/614/33819269-e3a3-a449-64fb-51749c82d9ca_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600250/614/33819269-e3a3-a449-64fb-51749c82d9ca_1280x720.mp4","playerId":203497,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600250/614/33819269-e3a3-a449-64fb-51749c82d9ca_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600250/614/33819269-e3a3-a449-64fb-51749c82d9ca_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026