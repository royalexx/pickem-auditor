M21.70S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1643721,"playerName":"Cooper","playerNameI":"C. Cooper","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"Cooper Out of Bounds - Bad Pass Turnover Turnover (P1.T17)","actionType":"Turnover","subType":"Out of Bounds - Bad Pass Turnover","videoAvailable":1,"shotValue":0,"actionId":525},{"actionNumber":743,"clock":"PT00M13.90S","period":4,"teamId":1610612758,"teamTricode":"SAC","personId":1643567,"playerName":"Sharp","playerNameI":"E. Sharp","xLegacy":113,"yLegacy":237,"shotDistance":26,"shotResult":"Missed","isFieldGoal":1,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"MISS Sharp 26' 3PT Jump Shot","actionType":"Missed Shot","subType":"Jump Shot","videoAvailable":1,"shotValue":3,"actionId":526},{"actionNumber":744,"clock":"PT00M13.90S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1641707,"playerName":"Hendricks","playerNameI":"T. Hendricks","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"Hendricks REBOUND (Off:0 Def:1)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":527},{"actionNumber":745,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"136","scoreAway":"105","pointsTotal":241,"location":"","description":"End of 4th Period (10:35 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":528}],"source":"hanaV3"},"headline":"Grizzlies improve to 6-0","heroImage":"https://cdn.nba.com/manage/2026/10/GettyImages-2302449705-scaled-e1793500413795.jpg","story":{"header":{"headline":"Boozer, Stewart lead Memphis to a 136-105 victory over Kings as Grizzlies remain unbeaten","byline":"By CLAY BAILEY","bytitle":"Associated Press"},"date":"2026-11-01T18:47:42","content":["MEMPHIS, Tenn. (AP)  Rookie Cameron Boozer had 27 points and nine rebounds, Isaiah Stewart added 24 points as the Memphis Grizzlies remained the only unbeaten team in the NBA with a 136-105 victory over the Sacramento Kings on Saturday night.","The Grizzlies' 6-0 record matches the 2014-15 season for the best start in franchise history. After the Houston Rockets' 116-111 loss at Dallas on Friday night, Memphis was the last unbeaten team in the league. The Grizzlies dominated the Kings in the second half to coast home, with the lead reaching 34 in the second half.","GG Jackson finished with 21 points, connecting on all five of his 3-pointers as Memphis built its lead in the first half. Cam Spencer, starting at point guard as Ty Jerome and Scotty Pippen Jr. sat out with back issues, had 10 points and 13 assists.","Meanwhile, the Kings, led by 38 points from Darus Acuff Jr., continue to struggle in the season's early stages, dropping to 0-6. Acuff, the rookie from Arkansas, scored 34 points against New Orleans in a loss Thursday, De'Andre Hunter finished with 19 points. Domantas Sabonis and Zach LaVine scored 11 points each, Sabonis adding 14 rebounds and eight assists.","Memphis led by 21 points in the first half behind Jackson's 3-point shooting, but Acuff was able to keep the Kings into the game with 21 first-half points. The Grizzlies led a 66-55 lead at intermission as Jackson connected on all five of his 3-point attempts.","The double-digit margin ballooned to 30 in the third quarter as Stewart and Boozer, the third pick in last summer's draft fueled the Memphis offense. The Grizzlies outscored Sacramento 42-25 in the third.","Kings: At Mavericks on Monday night.","Grizzlies: Host Pelicans on Monday night.","---","See AP’s full NBA coverage here"],"storyType":"recap"},"postId":2413057,"view":{"id":"box-score","label":"Box Score"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"SAC @ MEM, 2026-10-31","gameID":"0022600150","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"ESPN_Aus;QQ;ESPN_I_NZ;SiriusXM;DAZN-MEM;WMFS;NBCSCA/PCK-SAC;Kings Radio","venue":"FedExForum, Memphis, TN","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2414102,"title":"GG Jackson with the slam","shortTitle":"","permalink":"https://www.nba.com/watch/video/gg-jackson-with-the-slam-11?plsrc=nba\u0026game-highlights=0022600150","videoDuration":"00:13","featuredImage":"https://cdn.nba.com/manage/2026/11/d3ae6331-55cf-4dd8-abbc-f27577d31ee8_0.jpg","entitlements":"free","videoFranchisesName":{"individual-top-plays-wsc":"Individual Top Plays WSC"}},{"id":2413813,"title":"Highlights From Cameron Boozer 27-Point Game","shortTitle":"","permalink":"https://www.nba.com/watch/video/highlights-from-cameron-boozer-27-point-game?plsrc=nba\u0026game-highlights=0022600150","videoDuration":"01:35","featuredImage":"https://cdn.nba.com/manage/2026/10/05777265-336b-405a-b007-6af1e2a52a59_0.jpg","entitlements":"","videoFranchisesName":{"25-pts-gm":"25+ Points in a Game"}},{"id":2413807,"title":"Darius Acuff Jr. was in his bag tonight","shortTitle":"Darius Acuff Jr. goes off for 38 points","permalink":"https://www.nba.com/watch/video/highlights-from-darius-acuff-jr-38-point-game?plsrc=nba\u0026game-highlights=0022600150","videoDuration":"02:10","featuredImage":"https://cdn.nba.com/manage/2026/10/GettyImages-2302455963_cropped.jpg","entitlements":"free","videoFranchisesName":{"25-pts-gm":"25+ Points in a Game"}},{"id":2413782,"title":"Memphis Grizzlies vs. Sacramento Kings - 2nd Half Highlights","shortTitle":"","permalink":"https://www.nba.com/watch/video/memphis-grizzlies-vs-sacramento-kings-2nd-half-