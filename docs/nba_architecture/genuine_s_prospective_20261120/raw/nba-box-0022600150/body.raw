ng","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600150","gameCode":"20261031/SACMEM","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-01T00:00:00Z","gameEt":"2026-10-31T20:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-01T00:10:48Z","actualEndTimeUTC":"2026-11-01T02:35:03Z","gameDurationSeconds":8655,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612763,"teamName":"Grizzlies","teamCity":"Memphis","teamTricode":"MEM","teamSlug":"grizzlies","wins":6,"losses":0,"score":136,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":0,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":27},{"period":2,"periodType":"REGULAR","score":39},{"period":3,"periodType":"REGULAR","score":42},{"period":4,"periodType":"REGULAR","score":28}],"starters":[{"personId":1641744,"position":"C","lastName":"Edey","firstName":"Zach","status":"Confirmed"},{"personId":1642285,"position":"PG","lastName":"Spencer","firstName":"Cam","status":"Confirmed"},{"personId":1642377,"position":"SF","lastName":"Wells","firstName":"Jaylen","status":"Confirmed"},{"personId":1642907,"position":"SG","lastName":"Coward","firstName":"Cedric","status":"Confirmed"},{"personId":1643409,"position":"PF","lastName":"Boozer","firstName":"Cameron","status":"Confirmed"}]},"awayTeam":{"teamId":1610612758,"teamName":"Kings","teamCity":"Sacramento","teamTricode":"SAC","teamSlug":"kings","wins":0,"losses":6,"score":105,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":0,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":21},{"period":2,"periodType":"REGULAR","score":34},{"period":3,"periodType":"REGULAR","score":25},{"period":4,"periodType":"REGULAR","score":25}],"starters":[{"personId":203897,"position":"SG","lastName":"LaVine","firstName":"Zach","status":"Confirmed"},{"personId":1627734,"position":"C","lastName":"Sabonis","firstName":"Domantas","status":"Confirmed"},{"personId":1629631,"position":"SF","lastName":"Hunter","firstName":"De'Andre","status":"Confirmed"},{"personId":1630173,"position":"PF","lastName":"Achiuwa","firstName":"Precious","status":"Confirmed"},{"personId":1643411,"position":"PG","lastName":"Acuff Jr.","firstName":"Darius","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Memphis Grizzlies Dominate with depth and interior dominance","body":"The Memphis Grizzlies defeated the Sacramento Kings 136-105. Cameron Boozer led Memphis with 27 points and 9 rebounds on 8-for-14 shooting, while Isaiah Stewart added 24 points on an efficient 8-for-9 from the field. For Sacramento, Darius Acuff Jr. scored 38 points with 5 assists, connecting on 9-for-14 three-pointers, and De'Andre Hunter contributed 19 points. The Memphis Grizzlies paired a substantial advantage in bench scoring with an edge in paint scoring over the Sacramento Kings.\n\nSacramento mounted a late push, going on a 19–5 run in the fourth quarter, but Memphis answered decisively. The Grizzlies went on a 17–6 run down the stretch, capped by Jerami Grant's three-pointer that made the score 119–90 with 6:25 remaining, effectively putting the game out of reach. The Kings' offensive firepower, led by Darius Acuff Jr.'s perimeter shooting, could not overcome Memphis's depth and interior presence as the game progressed.\n\nIsaiah Stewart's shooting efficiency stood out sharply: he shot 35.3 percentage points above expectation on his 8-for-9 performance. Zach LaVine drew significant defensive attention for the Kings with an average Gravity of 17.6, yet that attention did not translate into enough offensive support. Cam Spencer's Total Leverage of 2.9 reflected Memphis's ability to maintain control through the final minutes, allowing the Grizzlies to close out comfortably in a lopsided victory."}},"defining_moments":{"gameId":"0022600150","moduleType":"defining_moments","definingMoments":[{"guid":"693d4669-fcaf-5e95-4faa-50af22f4f0f0","rank":1,"title":"Jerami Grant Delivers a Triple","summary":"Cameron Boozer found Jerami Grant, who delivered a three-pointer, and the Grizzlies led 119–90 with 6:25 remaining in the fourth.","category":"Scoring","eventNum":653,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600150/653/693d4669-fcaf-5e95-4faa-50af22f4f0f0_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600150/653/693d4669-fcaf-5e95-4faa-50af22f4f0f0_1280x720.mp4","playerId":203924,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600150/653/693d4669-fcaf-5e95-4faa-50af22f4f0f0_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600150/653/693d4669-fcaf-5e95-4faa-50af22f4f0f0_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600150/653/693d4669-fcaf-5e95-4faa-50af22f4f0f0.m3u8","largeDuration":11983,"smallDuration":11983,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600150/653/693d4669-fcaf-5e95-4faa-50af22f4f0f0_1280x720.jpg","mediumDuration":11983,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/10/31/0022600150/653/693d4669-fcaf-5e95-4faa-50af22f4f0f0_320x180.jpg","mediumThumbnail":"https://videos.nba.com/n