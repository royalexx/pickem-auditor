tPeriod\\\":0,\\\"endPeriod\\\":0,\\\"startRange\\\":0,\\\"endRange\\\":28800}\",\"rangeTime\":[0,28800],\"isCustomRange\":false}"},"initialQueryParams":{"props":["mil-vs-min-0022600166","box-score"]},"istGroup":{},"banner":{"desktop":"https://cdn.nba.com/manage/2025/09/header-inside-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600166","gameCode":"20261102/MILMIN","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-03T01:00:00Z","gameEt":"2026-11-02T20:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-03T01:10:51Z","actualEndTimeUTC":"2026-11-03T03:26:27Z","gameDurationSeconds":8136,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612750,"teamName":"Timberwolves","teamCity":"Minnesota","teamTricode":"MIN","teamSlug":"timberwolves","wins":5,"losses":3,"score":112,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":1,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":29},{"period":2,"periodType":"REGULAR","score":19},{"period":3,"periodType":"REGULAR","score":32},{"period":4,"periodType":"REGULAR","score":32}],"starters":[{"personId":203497,"position":"C","lastName":"Gobert","firstName":"Rudy","status":"Confirmed"},{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630228,"position":"PF","lastName":"Kuminga","firstName":"Jonathan","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"}]},"awayTeam":{"teamId":1610612749,"teamName":"Bucks","teamCity":"Milwaukee","teamTricode":"MIL","teamSlug":"bucks","wins":1,"losses":6,"score":100,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":0,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":18},{"period":2,"periodType":"REGULAR","score":29},{"period":3,"periodType":"REGULAR","score":29},{"period":4,"periodType":"REGULAR","score":24}],"starters":[{"personId":1626167,"position":"C","lastName":"Turner","firstName":"Myles","status":"Confirmed"},{"personId":1628398,"position":"PF","lastName":"Kuzma","firstName":"Kyle","status":"Confirmed"},{"personId":1629639,"position":"SG","lastName":"Herro","firstName":"Tyler","status":"Confirmed"},{"personId":1631170,"position":"SF","lastName":"Jaquez Jr.","firstName":"Jaime","status":"Confirmed"},{"personId":1643415,"position":"PG","lastName":"Burries","firstName":"Brayden","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"defensive_spotlight","order":4},{"moduleType":"leverage_spotlight","order":5}],"gameOverview":{"title":"The Minnesota Timberwolves Earn the Win","body":"The Minnesota Timberwolves defeated the Milwaukee Bucks 112-100. LaMelo Ball led the Timberwolves with 34 points on 12-for-21 shooting, including 6-for-13 from three, while adding 6 rebounds and 3 assists. Ayo Dosunmu contributed 19 points, 12 rebounds and 8 assists on 8-for-18 from the field. For the Bucks, Tyler Herro scored 21 points with 6 rebounds, and Jaime Jaquez Jr. added 19 points and 8 rebounds on 8-for-17 shooting.\n\nMinnesota built an early lead behind LaMelo Ball's perimeter shooting in the first quarter, but Milwaukee answered to pull within one at halftime. The Timberwolves extended their advantage through the third quarter behind Trey Lyles and then pulled away decisively in the fourth, with Ayo Dosunmu hitting crucial baskets down the stretch to secure the win.\n\nBall's offensive performance stood out beyond the scoring line. He drew above-expected defensive pressure, recording an Average Gravity of 10.3, while shooting 19.1 percentage points above expectation. Dosunmu's all-around impact registered a Total Leverage of 2.7, reflecting his contributions across multiple facets of the game as Minnesota controlled the pace and execution down the stretch."}},"defining_moments":{"gameId":"0022600166","moduleType":"defining_moments","definingMoments":[{"guid":"e1af5c26-01c6-2094-7563-0284c62340f0","rank":1,"title":"Trey Lyles Finishes the Layup","summary":"Ayo Dosunmu found Trey Lyles for the layup, and the Timberwolves led 102–89 with 3:13 remaining in the fourth.","category":"Scoring","eventNum":679,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/02/0022600166/679/e1af5c26-01c6-2094-7563-0284c62340f0_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/02/0022600166/679/e1af5c26-01c6-2094-7563-0284c62340f0_1280x720.mp4","playerId":1626168,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/02/0022600166/679/e1af5c26-01c6-2094-7563-0284c62340f0_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/02/0022600166/679/e1af5c26-01c6-2094-7563-0284c62340f0_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/02/0022600166/679/e1af5c26-01c6-2094-7563-0284c62340f0.m3u8","largeDuration":10366,"smallDuration":10366,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/02/0022600166/679/e1af5c26-01c6-2094-7563-0284c62340f0_1280x720.jpg","mediumDuration":10366,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/02/0022600166/679/e1af5c26-01c6-2094-7563-0284c62340f0_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/