ars","firstName":"Jeremiah","status":"Confirmed"}]},"awayTeam":{"teamId":1610612750,"teamName":"Timberwolves","teamCity":"Minnesota","teamTricode":"MIN","teamSlug":"timberwolves","wins":7,"losses":3,"score":115,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":2,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":27},{"period":2,"periodType":"REGULAR","score":30},{"period":3,"periodType":"REGULAR","score":20},{"period":4,"periodType":"REGULAR","score":38}],"starters":[{"personId":203497,"position":"C","lastName":"Gobert","firstName":"Rudy","status":"Confirmed"},{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630228,"position":"PF","lastName":"Kuminga","firstName":"Jonathan","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Minnesota Timberwolves Earn the Win","body":"The Minnesota Timberwolves defeated the New Orleans Pelicans 115-109. Ayo Dosunmu led the Timberwolves with 26 points on 8-for-14 shooting, including 4-for-6 from three-point range, while adding 4 assists. Jaden McDaniels contributed 23 points, 6 rebounds and 5 assists for Minnesota. For New Orleans, Jeremiah Fears scored 24 points on 9-for-16 shooting with 5 rebounds and 5 assists, and Karlo Matković added 18 points on 7-for-13 shooting, including 4-for-8 from three.\n\nMinnesota built an early advantage with an 18–4 run spanning the opening minutes of the first quarter. New Orleans responded with momentum of their own, posting a 23–7 run that brought them back into contention. The Pelicans' attack generated scoring opportunities throughout the contest, but the Timberwolves maintained their edge down the stretch. Jonathan Kuminga finished with a dunk that made the score 115–109 in favor of the Timberwolves with 0:06 remaining in the fourth. The New Orleans Pelicans paired an edge in fast-break scoring with an edge in bench scoring over the Minnesota Timberwolves.\n\nDosunmu shot 6.0 percentage points above expectation, converting at a higher rate than an average NBA player would be expected to convert the same tracked shot opportunities. LaMelo Ball drew above-expected defensive pressure, recording an Average Gravity of 11.3, while Dosunmu's overall impact measured 3.1 in Total Leverage across all areas of the game."}},"defining_moments":{"gameId":"0022600031","moduleType":"defining_moments","definingMoments":[{"guid":"df2035d7-6cb5-2bfd-2da6-4881aea0460a","rank":1,"title":"Jonathan Kuminga Throws It Down","summary":"Jonathan Kuminga finished with a dunk, making it 115–109 in favor of the Timberwolves with 6 seconds remaining in the fourth.","category":"Scoring","eventNum":722,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/06/0022600031/722/df2035d7-6cb5-2bfd-2da6-4881aea0460a_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/06/0022600031/722/df2035d7-6cb5-2bfd-2da6-4881aea0460a_1280x720.mp4","playerId":1630228,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/06/0022600031/722/df2035d7-6cb5-2bfd-2da6-4881aea0460a_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/06/0022600031/722/df2035d7-6cb5-2bfd-2da6-4881aea0460a_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/06/0022600031/722/df2035d7-6cb5-2bfd-2da6-4881aea0460a.m3u8","largeDuration":11150,"smallDuration":11150,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/06/0022