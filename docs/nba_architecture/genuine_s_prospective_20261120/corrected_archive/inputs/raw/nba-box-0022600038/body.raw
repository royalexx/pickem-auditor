pointsTotal":0,"location":"v","description":"MISS Hendricks Free Throw Flagrant 2 of 2","actionType":"Free Throw","subType":"Free Throw Flagrant 2 of 2","videoAvailable":1,"shotValue":0,"actionId":551},{"actionNumber":766,"clock":"PT00M44.10S","period":4,"teamId":0,"teamTricode":"","personId":1610612763,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Grizzlies Rebound","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":552},{"actionNumber":767,"clock":"PT00M26.40S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1642914,"playerName":"Small","playerNameI":"J. Small","xLegacy":16,"yLegacy":48,"shotDistance":5,"shotResult":"Made","isFieldGoal":1,"scoreHome":"109","scoreAway":"140","pointsTotal":249,"location":"v","description":"Small 5' Driving Layup (10 PTS) (Spencer 5 AST)","actionType":"Made Shot","subType":"Driving Layup Shot","videoAvailable":1,"shotValue":2,"actionId":553},{"actionNumber":768,"clock":"PT00M14.80S","period":4,"teamId":1610612740,"teamTricode":"NOP","personId":1643738,"playerName":"Dia","playerNameI":"M. Dia","xLegacy":-5,"yLegacy":16,"shotDistance":2,"shotResult":"Made","isFieldGoal":1,"scoreHome":"111","scoreAway":"140","pointsTotal":251,"location":"h","description":"Dia 2' Layup (2 PTS) (Queen 2 AST)","actionType":"Made Shot","subType":"Layup Shot","videoAvailable":1,"shotValue":2,"actionId":554},{"actionNumber":770,"clock":"PT00M07.30S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1641765,"playerName":"Prosper","playerNameI":"O. Prosper","xLegacy":-11,"yLegacy":7,"shotDistance":1,"shotResult":"Made","isFieldGoal":1,"scoreHome":"111","scoreAway":"142","pointsTotal":253,"location":"v","description":"Prosper 1' Driving Layup (6 PTS)","actionType":"Made Shot","subType":"Driving Layup Shot","videoAvailable":1,"shotValue":2,"actionId":555},{"actionNumber":771,"clock":"PT00M00.50S","period":4,"teamId":1610612740,"teamTricode":"NOP","personId":1643738,"playerName":"Dia","playerNameI":"M. Dia","xLegacy":151,"yLegacy":259,"shotDistance":30,"shotResult":"Missed","isFieldGoal":1,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"h","description":"MISS Dia 30' 3PT Jump Shot","actionType":"Missed Shot","subType":"Jump Shot","videoAvailable":1,"shotValue":3,"actionId":556},{"actionNumber":772,"clock":"PT00M00.50S","period":4,"teamId":1610612763,"teamTricode":"MEM","personId":1631200,"playerName":"Murray","playerNameI":"K. Murray","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"","scoreAway":"","pointsTotal":0,"location":"v","description":"Murray REBOUND (Off:0 Def:1)","actionType":"Rebound","subType":"Unknown","videoAvailable":1,"shotValue":0,"actionId":557},{"actionNumber":773,"clock":"PT00M00.00S","period":4,"teamId":0,"teamTricode":"","personId":0,"playerName":"","playerNameI":"","xLegacy":0,"yLegacy":0,"shotDistance":0,"shotResult":"","isFieldGoal":0,"scoreHome":"111","scoreAway":"142","pointsTotal":253,"location":"","description":"End of 4th Period (10:39 PM EST)","actionType":"period","subType":"end","videoAvailable":1,"shotValue":0,"actionId":558}],"source":"hanaV3"},"headline":"Balanced Grizzlies cruise","heroImage":"https://cdn.nba.com/manage/2026/11/GettyImages-2304502123-scaled-e1794627290685.jpg","story":{"header":{"headline":"Grizzlies have record-tying 10 double-figure scorers in 142-111 romp over Pelicans in NBA Cup play","byline":"By PETER FINNEY JR.","bytitle":"Associated Press"},"date":"2026-11-14T00:21:47","content":["NEW ORLEANS (AP)  Jerami Grant scored 22 points, including seven points on an extended possession in the first half, and the Memphis Grizzlies routed the New Orleans Pelicans 142-111 in NBA Cup group play Friday night.","The Grizzlies matched an NBA record with 10 players in double figures in scoring. Ty Jerome had 17, Cedric Coward, GG Jackson and Cam Spencer added 14 each, Isaiah Stewart and Cam Boozer each had 12, Jaylen Wells scored 11, and Taylor Hendricks and Javon Small had 10 each.","In winning their sixth consecutive road game - the best road record in the NBA and the best road start in franchise history - the Grizzlies overwhelmed the Pelicans with their perimeter shooting, finishing 18 of 45 from 3-point range while holding New Orleans to 7 of 31.","The Grizzlies improved their NBA Cup record to 1-1 in the West’s Group B, and the Pelicans dropped to 0-2.","The Grizzlies scored 13 consecutive points in a 1:07 span of the second quarter to build a 62-46 lead. Grant had seven points in seven seconds, nailing a pair of 3s and adding a foul shot after Zion Williamson was called for an illegal closeout..","Grant left with 7:36 left after colliding with Herb Jones on a head-first drive to the basket.","Saddiq Bey led New Orleans with 30 points, the first Pelican to score more than 30 points this season. Williamson had 22 points, five rebounds and three steals.","Memphis led 70-58 at the half and then 105-86 after three, stringing together three consecutive 35-point quarters. They added a 37-point fourth quarter to complete the rout.","Grizzlies: Host Brooklyn on Saturday night.","Pelicans: Host Denver on Saturday night.","---","See AP’s full NBA coverage here"],"storyType":"recap"},"postId":2432043,"view":{"id":"box-score","label":"Box Score"},"region":"international-canada","analyticsObject":{"shared":{"gameMatchup":"MEM @ NOP, 2026-11-13","gameID":"0022600038","gameState":"ondemand","gameQuarter":"Final","gameBroadcasters":"SiriusXM;GCSEN;WWL;DTC-NOP;DAZN-MEM;WMFS","venue":"Smoothie King Center, New Orleans, LA","season":2026,"seasonType":"Regular Season","gameClock":"PT00M00.00S"},"blueprint":{"id":1853175,"title":"Inside the Game","categoryPrimary":{"name":"Inside the Game","id":52390},"taxonomy":{"categories":{"inside-the-game":"Inside the Game"}}}},"highlightVideos":[{"id":2432898,"title":"Highlig