eriod":true,"val":"Q4","pct":0.75,"json":"{\"rangeType\":1,\"startPeriod\":4,\"endPeriod\":4,\"startRange\":21600,\"endRange\":28800}"},{"RangeType":1,"lp":0,"isOT":false,"text":"1st Half","val":"1stHalf","startTime":0,"endTime":14400,"startPeriod":1,"endPeriod":2,"json":"{\"rangeType\":1,\"startPeriod\":1,\"endPeriod\":2,\"startRange\":0,\"endRange\":14400}"},{"RangeType":1,"lp":0,"isOT":false,"text":"2nd Half","val":"2ndHalf","startTime":14400,"endTime":28800,"startPeriod":3,"endPeriod":4,"json":"{\"rangeType\":1,\"startPeriod\":3,\"endPeriod\":4,\"startRange\":14400,\"endRange\":28800}"}],"boxscoreParams":{"defaultRangeString":"0-28800","initialBoxscoreCacheKey":"{\"resource\":\"traditional\",\"gameId\":\"0022600247\",\"rangePeriod\":\"{\\\"rangeType\\\":0,\\\"startPeriod\\\":0,\\\"endPeriod\\\":0,\\\"startRange\\\":0,\\\"endRange\\\":28800}\",\"rangeTime\":[0,28800],\"isCustomRange\":false}"},"initialQueryParams":{"props":["mem-vs-was-0022600247","box-score"]},"istGroup":{},"banner":{"desktop":"https://cdn.nba.com/manage/2025/09/header-inside-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600247","gameCode":"20261116/MEMWAS","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-11-17T00:00:00Z","gameEt":"2026-11-16T19:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-11-17T00:10:54Z","actualEndTimeUTC":"2026-11-17T02:27:43Z","gameDurationSeconds":8209,"poRound":0,"poRoundDesc":"","gameSubtype":"","seriesConference":"","seriesSubText":"","gameLabel":"","gameSubLabel":"","scoreStripSpoilerHeader":"","scoreStripNonSpoilerHeader":"","isNeutral":false,"homeTeam":{"teamId":1610612764,"teamName":"Wizards","teamCity":"Washington","teamTricode":"WAS","teamSlug":"wizards","wins":4,"losses":11,"score":120,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":35},{"period":2,"periodType":"REGULAR","score":34},{"period":3,"periodType":"REGULAR","score":18},{"period":4,"periodType":"REGULAR","score":33}],"starters":[{"personId":203076,"position":"PF","lastName":"Davis","firstName":"Anthony","status":"Confirmed"},{"personId":1629027,"position":"PG","lastName":"Young","firstName":"Trae","status":"Confirmed"},{"personId":1642259,"position":"C","lastName":"Sarr","firstName":"Alex","status":"Confirmed"},{"personId":1642273,"position":"SF","lastName":"George","firstName":"Kyshawn","status":"Confirmed"},{"personId":1643407,"position":"SG","lastName":"Dybantsa","firstName":"AJ","status":"Confirmed"}]},"awayTeam":{"teamId":1610612763,"teamName":"Grizzlies","teamCity":"Memphis","teamTricode":"MEM","teamSlug":"grizzlies","wins":10,"losses":4,"score":136,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":1,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":33},{"period":2,"periodType":"REGULAR","score":26},{"period":3,"periodType":"REGULAR","score":42},{"period":4,"periodType":"REGULAR","score":35}],"starters":[{"personId":1641744,"position":"C","lastName":"Edey","firstName":"Zach","status":"Confirmed"},{"personId":1642285,"position":"PG","lastName":"Spencer","firstName":"Cam","status":"Confirmed"},{"personId":1642377,"position":"SF","lastName":"Wells","firstName":"Jaylen","status":"Confirmed"},{"personId":1642907,"position":"SG","lastName":"Coward","firstName":"Cedric","status":"Confirmed"},{"personId":1643409,"position":"PF","lastName":"Boozer","firstName":"Cameron","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Memphis Grizzlies Earn the Win","body":"The Memphis Grizzlies defeated the Washington Wizards 136-120. Cameron Boozer led the Memphis Grizzlies with 29 points on 10-for-21 shooting, adding 7 rebounds and 7 assists, while connecting on 7-for-13 three-pointers. Zach Edey contributed 23 points and 10 rebounds on efficient 10-for-15 shooting. For the Washington Wizards, Anthony Davis scored 23 points on 8-for-15 shooting, and AJ Dybantsa added 21 points with 5 rebounds across 7-for-16 from the field.\n\nThe Wizards mounted early pressure, going on a 19–4 run in the second quarter to build momentum. Memphis responded with a decisive 18–4 run that stretched from late in the third quarter into the fourth, shifting control decisively in their favor. The Grizzlies' interior presence proved consequential as the game progressed. The Washington Wizards held an edge in free-throw opportunities, while the Memphis Grizzlies had an edge in paint scoring. Boozer's three-pointer with 2:41 remaining in the fourth made the score 128–112 in favor of Memphis, effectively sealing the outcome.\n\nKyshawn George shot 10.2 percentage points above expectation for the Wizards. Jaylen Wells drew above-expected defensive pressure for the Grizzlies, recording Average Gravity of 11.5. Cedric Coward recorded Total Leverage of 2.8 in the Memphis victory."}},"defining_moments":{"gameId":"0022600247","moduleType":"defining_moments","definingMoments":[{"guid":"4c1caef3-6f15-c389-63e1-7e44d1ed575d","rank":1,"title":"Cameron Boozer Delivers a Triple","summary":"Javon Small found Cameron Boozer, who delivered a three-pointer, and the Grizzlies led 128–112 with 2:41 remaining in the fourth.","category":"Scoring","eventNum":703,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/703/4c1caef3-6f15-c389-63e1-7e44d1ed575d_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/703/4c1caef3-6f15-c389-63e1-7e44d1ed575d_1280x720.mp4","playerId":1643409,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/703/4c1caef3-6f15-c389-63e1-7e44d1ed575d_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/703/4c1caef3-6f15-c389-63e1-7e44d1ed575d_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/703/4c1caef3-6f15-c389-63e1-7e44d1ed575d.m3u8","largeDuration":8700,"smallDuration":8700,"largeThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/703/4c1caef3-6f15-c389-63e1-7e44d1ed575d_1280x720.jpg","mediumDuration":8700,"smallThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/703/4c1caef3-6f15-c389-63e1-7e44d1ed575d_320x180.jpg","mediumThumbnail":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/703/4c1caef3-6f15-c389-63e1-7e44d1ed575d_960x540.jpg"},{"guid":"db3196ab-20f2-3146-13cf-dc644a263523","rank":2,"title":"Cameron Boozer Finds the Mark from Three","summary":"Cameron Boozer converted a running three-pointer on a feed from Jaylen Wells, and the Wizards led 73–68 with 9:16 remaining in the third.","category":"Scoring","eventNum":407,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/407/db3196ab-20f2-3146-13cf-dc644a263523_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/407/db3196ab-20f2-3146-13cf-dc644a263523_1280x720.mp4","playerId":1643409,"smallHls":"","smallUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/407/db3196ab-20f2-3146-13cf-dc644a263523_320x180.mp4","mediumHls":"","mediumUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/407/db3196ab-20f2-3146-13cf-dc644a263523_960x540.mp4","playListUrl":"https://videos.nba.com/nba/pbp/media/2026/11/16/0022600247/407/db3196ab-20f2-3146-13cf-dc644a263523.m3u8","largeDuratio