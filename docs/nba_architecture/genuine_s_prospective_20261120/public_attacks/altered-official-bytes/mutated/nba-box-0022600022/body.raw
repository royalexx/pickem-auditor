chedIstKnockout":0,"clinchedIstGroup":0,"clinchedIstWildcard":0,"istWildcardRank":15,"istGroupRank":5,"istKnockoutRank":null,"wins":0,"losses":2,"pct":0,"istGroupGb":2,"istWildcardGb":1.5,"diff":-37,"pts":220,"oppPts":257,"games":[{"gameId":"0022600031","gameNumber":1,"opponentTeamAbbreviation":"MIN","location":"H","gameStatus":3,"gameStatusText":"Final","outcome":"L"},{"gameId":"0022600038","gameNumber":2,"opponentTeamAbbreviation":"MEM","location":"H","gameStatus":3,"gameStatusText":"Final","outcome":"L"},{"gameId":"0022600048","gameNumber":3,"opponentTeamAbbreviation":"OKC","location":"A","gameStatus":1,"gameStatusText":"8:00 pm ET","outcome":""},{"gameId":"0022600073","gameNumber":4,"opponentTeamAbbreviation":"LAC","location":"A","gameStatus":1,"gameStatusText":"9:30 pm ET","outcome":""}]}]},"banner":{"desktop":"https://cdn.nba.com/manage/2025/09/header-inside-the-game-desktop.png","mobile":"https://cdn.nba.com/manage/2025/09/header-inside-the-gamemobile-scaled.png"},"blueprintReport":{"game_header":{"gameId":"0022600022","gameCode":"20261030/LACMIN","gameStatus":3,"gameStatusText":"Final","gameBreakStatus":"Final","period":4,"gameClock":"PT00M00.00S","gameTimeUTC":"2026-10-31T00:00:00Z","gameEt":"2026-10-30T20:00:00","seasonYear":"2026-27","seasonType":"Regular Season","regulationPeriods":4,"seriesGameNumber":"","seriesText":"","ifNecessary":false,"targetScoreEnding":false,"targetScorePeriod":0,"targetScore":0,"actualStartTimeUTC":"2026-10-31T00:10:35Z","actualEndTimeUTC":"2026-10-31T02:21:15Z","gameDurationSeconds":7840,"poRound":0,"poRoundDesc":"","gameSubtype":"in-season","seriesConference":"","seriesSubText":"","gameLabel":"Emirates NBA Cup","gameSubLabel":"West Group B","scoreStripSpoilerHeader":"West Group B","scoreStripNonSpoilerHeader":"West Group B","isNeutral":false,"homeTeam":{"teamId":1610612750,"teamName":"Timberwolves","teamCity":"Minnesota","teamTricode":"MIN","teamSlug":"timberwolves","wins":4,"losses":2,"score":127,"seed":0,"inBonus":null,"timeoutsRemaining":1,"groupWins":1,"groupLosses":0,"periods":[{"period":1,"periodType":"REGULAR","score":34},{"period":2,"periodType":"REGULAR","score":35},{"period":3,"periodType":"REGULAR","score":29},{"period":4,"periodType":"REGULAR","score":29}],"starters":[{"personId":203497,"position":"C","lastName":"Gobert","firstName":"Rudy","status":"Confirmed"},{"personId":1630163,"position":"PG","lastName":"Ball","firstName":"LaMelo","status":"Confirmed"},{"personId":1630183,"position":"SF","lastName":"McDaniels","firstName":"Jaden","status":"Confirmed"},{"personId":1630228,"position":"PF","lastName":"Kuminga","firstName":"Jonathan","status":"Confirmed"},{"personId":1630245,"position":"SG","lastName":"Dosunmu","firstName":"Ayo","status":"Confirmed"}]},"awayTeam":{"teamId":1610612746,"teamName":"Clippers","teamCity":"LA","teamTricode":"LAC","teamSlug":"clippers","wins":1,"losses":4,"score":101,"seed":0,"inBonus":null,"timeoutsRemaining":0,"groupWins":0,"groupLosses":1,"periods":[{"period":1,"periodType":"REGULAR","score":24},{"period":2,"periodType":"REGULAR","score":32},{"period":3,"periodType":"REGULAR","score":25},{"period":4,"periodType":"REGULAR","score":20}],"starters":[{"personId":1627739,"position":"SG","lastName":"Dunn","firstName":"Kris","status":"Confirmed"},{"personId":1627884,"position":"SF","lastName":"Jones Jr.","firstName":"Derrick","status":"Confirmed"},{"personId":1629060,"position":"PF","lastName":"Hachimura","firstName":"Rui","status":"Confirmed"},{"personId":1629636,"position":"PG","lastName":"Garland","firstName":"Darius","status":"Confirmed"},{"personId":1630543,"position":"C","lastName":"Jackson","firstName":"Isaiah","status":"Confirmed"}]},"reportModules":[{"moduleType":"game_header","order":0},{"moduleType":"defining_moments","order":1},{"moduleType":"top_performers","order":2},{"moduleType":"shot_difficulty","order":3},{"moduleType":"gravity_spotlight","order":4},{"moduleType":"defensive_spotlight","order":5},{"moduleType":"leverage_spotlight","order":6}],"gameOverview":{"title":"The Minnesota Timberwolves Earn the Win","body":"The Minnesota Timberwolves defeated the LA Clippers 127-101. Jaden McDaniels led the Timberwolves with 23 points on an efficient 11-for-15 shooting, adding 6 rebounds and 7 assists. LaMelo Ball contributed 24 points, 7 assists and 4 rebounds on 9-for-20 from the field, including 6-for-15 from three. For the Clippers, Darius Garland matched Ball's 24 points with 5 assists on 10-for-22 shooting, while Brook Lopez added 13 points and 6 rebounds on 5-for-10 from the field.\n\nThe Clippers mounted a 10–0 run in the third quarter and early fourth, but the Timberwolves responded decisively. Minnesota built momentum through the fourth quarter, executing a dominant 23–2 run that effectively sealed the contest. The Minnesota Timberwolves paired an edge in paint scoring with an edge in bench scoring over the LA Clippers. McDaniels capped the performance with a dunk that made the score 116–92 in favor of the Timberwolves with 4:55 remaining in the fourth.\n\nMcDaniels' shooting efficiency stood out as a defining factor in the victory. He shot 16.5 percentage points above expectation on his 11 attempts, converting at 73.3% against a shot difficulty of 56.8%. Jaylen Clark drew an average gravity of 10.6, while McDaniels' overall impact registered at 2.9 total leverage, underscoring his two-way contributions throughout the contest."}},"defining_moments":{"gameId":"0022600022","moduleType":"defining_moments","definingMoments":[{"guid":"529f9926-b8e7-6487-b232-fb5246b9e0c4","rank":1,"title":"Jaden McDaniels Throws It Down","summary":"LaMelo Ball found Jaden McDaniels on the drive, and McDaniels converted the dunk, making it 116–92 in favor of the Timberwolves with 4:55 remaining in the fourth.","category":"Scoring","eventNum":598,"largeHls":"https://videos.nba.com/nba/pbp/media/2026/10/30/0022600022/598/529f9926-b8e7-6487-b232-fb5246b9e0c4_hls_3500kbps_1280x720.m3u8","largeUrl":"https://videos.nba.com/n