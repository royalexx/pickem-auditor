Z","featuredImage":{"type":"image","html":null,"text":null,"attributes":{"id":"1158731","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-36.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"id":"1158731","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-36.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"category":"Features","language":"en","taxonomy":{"categories":{"features":"Features"},"tags":{"2026-27-season":"2026-27 Season"},"games":{"0022600120":"10/26/2026 MIN@CLE 0022600120"},"teams":{"1610612739":"Cleveland Cavaliers"},"players":{"201935":"James Harden","1628378":"Donovan Mitchell","1630596":"Evan Mobley","1643509":"Meleek Thomas"}},"attributes":{"hideAuthor":false,"hideTimestamp":false,"relatedContent":{"source":"manual","sourceId":null,"content":[]},"subhead":"","featuredMediaContentGrid":{"type":"image","html":null,"text":null,"attributes":{"id":"1158731","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-36.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}}},"hideContent":false,"nbaId":{"restricted":false}},"syndication":{"platforms":{"app":true,"web":true}},"author":{"id":43,"name":"clejgabriele"}},{"id":1158619,"type":"article","name":"features-jarrett-allen-rookie-tales-261024","title":"Rookie Tales: Jarrett Allen","status":"publish","slug":"features-jarrett-allen-rookie-tales-261024","permalink":"https://www.nba.com/cavaliers/news/features-jarrett-allen-rookie-tales-261024","excerpt":"Now a 10-year veteran, Allen took a moment to look back on the ups and downs of his freshman year with Kenny Atkinson’s Nets in today’s installment of Rookie Tales.","timestamp":1792891979000,"date":"2026-10-25T01:32:59Z","modified":"2026-10-25T01:33:45Z","featuredImage":{"type":"image","html":null,"text":null,"attributes":{"id":"1158621","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-35.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"id":"1158621","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-35.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"category":"Features","language":"en","taxonomy":{"categories":{"features":"Features"},"tags":{"2026-27-season":"2026-27 Season"},"teams":{"1610612739":"Cleveland Cavaliers"},"players":{"1628386":"Jarrett Allen"}},"attributes":{"hideAuthor":false,"hideTimestamp":false,"relatedContent":{"source":"manual","sourceId":null,"content":[]},"subhead":"","featuredMediaContentGrid":{"type":"image","html":null,"text":null,"attributes":{"id":"1158621","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-35.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}}},"hideContent":false,"nbaId":{"restricted":false}},"syndication":{"platforms":{"app":true,"web":true}},"author":{"id":43,"name":"clejgabriele"}},{"id":1158521,"type":"article","name":"features-season-opener-261021","title":"What to Watch for on Wednesday in Cleveland's Season Opener","status":"publish","slug":"features-season-opener-261021","permalink":"https://www.nba.com/cavaliers/news/features-season-opener-261021","excerpt":"Kenny Atkinson will send out some newcomers of his own on Thursday night, as Cleveland tips off the 56th season in franchise history looking to finish what they started last spring. Here are a few things to look for when the ball goes up at 7:00 p.m. in Philly on Wednesday night …","timestamp":1792622361000,"date":"2026-10-21T22:39:21Z","modified":"2026-10-21T22:40:47Z","featuredImage":{"type":"image","html":null,"text":null,"attributes":{"id":"1158524","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-34.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"id":"1158524","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-34.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"category":"Features","language":"en","taxonomy":{"categories":{"features":"Features"},"tags":{"2026-27-season":"2026-27 Season"},"games":{"0022600006":"10/22/2026 CLE@PHI 0022600006"},"teams":{"1610612739":"Cleveland Cavaliers","1610612755":"Philadelphia 76ers"},"players":{"201935":"James Harden","1626209":"Mario Hezonja","1628378":"Donovan Mitchell","1628386":"Jarrett Allen","1630596":"Evan Mobley","1631212":"Peyton Watson","1641772":"Nae'Qwan Tomlin","1641854":"Craig Porter Jr.","1642878":"Tyrese Proctor","1643509":"Meleek Thomas"}},"attributes":{"hideAuthor":false,"hideTimestamp":false,"relatedContent":{"source":"manual","sourceId":null,"content":[]},"subhead":"","featuredMediaContentGrid":{"type":"image","html":null,"text":null,"attributes":{"id":"1158524","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-34.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}}},"hideContent":false,"nbaId":{"restricted":false}},"syndication":{"platforms":{"app":true,"web":true}},"author":{"id":1033,"name":"Cavaliers"}},{"id":1158471,"type":"article","name":"features-craig-porter-jr-261019","title":"Craig Porter Jr. Has a Big Opportunity Ahead of Him in Year Four","status":"publish","slug":"features-craig-porter-jr-261019","permalink":"https://www.nba.com/cavaliers/news/features-craig-porter-jr-261019","excerpt":"And then there’s the “senior” of the group – Craig Porter Jr. – now heading into his fourth season after going undrafted out of Wichita State way back in 2023. Among Cleveland’s second unit players, only Sam Merrill, who appeared in five games with the Cavs in 2022-23, has been with the team longer. ","timestamp":1792414603000,"date":"2026-10-19T12:56:43Z","modified":"2026-10-19T12:58:30Z","featuredImage":{"type":"image","html":null,"text":null,"attributes":{"id":"1158473","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-31.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"id":"1158473","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-31.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"category":"Features","l