":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-29.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}},"category":"Features","language":"en","taxonomy":{"categories":{"features":"Features"},"tags":{"2026-27-season":"2026-27 Season"},"teams":{"1610612739":"Cleveland Cavaliers"},"players":{"201935":"James Harden","1626209":"Mario Hezonja","1628418":"Thomas Bryant","1631212":"Peyton Watson","1641854":"Craig Porter Jr.","1642281":"Jaylon Tyson","1642878":"Tyrese Proctor","1643509":"Meleek Thomas"}},"attributes":{"hideAuthor":false,"hideTimestamp":false,"relatedContent":{"source":"manual","sourceId":null,"content":[]},"subhead":"","featuredMediaContentGrid":{"type":"image","html":null,"text":null,"attributes":{"id":"1158439","src":"https://cdn.nba.com/teams/uploads/sites/1610612739/2026/10/TS-29.png","alt":"","caption":"","captionAlignment":"","captionColor":"","copyright":"","credit":"","link":"","align":"","size":{"width":1920,"height":1080},"anchor":"","focalPoint":{"x":0.5,"y":0.5},"direction":"ltr","animation":{"name":"none"}}},"hideContent":false,"nbaId":{"restricted":false}},"syndication":{"platforms":{"app":true,"web":true}},"author":{"id":43,"name":"clejgabriele"}},{"id":1158313,"type":"article","name":"features-tyrese-proctor-261009","title":"Tyrese Proctor Ahead of Year Two: \"I Feel Great, I Feel Confident\"","status":"publish","slug":"features-tyrese-proctor-261009","permalink":"https://www.nba.com/cavaliers/news/features-tyrese-proctor-261009","excerpt":"“I feel great with a year under my belt; I feel confident, I know my role,” said the 22-year-old. “I know what I’ve got to do to get on the court – try to make it easier for all the starters and just try and impact winning as much as I can. Knock down shots and play defense.” ","timestamp":1791551238000,"