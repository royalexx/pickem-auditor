  "official_transaction_content": {
    "title": "CAVALIERS SIGN ZACK AUSTIN TO TWO-WAY CONTRACT",
    "provider_declared_date": "2026-11-18T15:39:19Z",
    "provider_declared_modified": "2026-11-18T15:45:32Z",
    "subhead": "Team Waived Riley Minix",
    "transaction_statements": [
      "CLEVELAND\u00a0\u2013 The Cleveland Cavaliers have signed forward\u00a0Zack Austin\u00a0to a two-way contract, Cavaliers President of Basketball Operations Koby Altman announced today from Cleveland Clinic Courts.",
      "In a related move, the team has waived forward Riley Minix,\u00a0who\u00a0appeared in 10 games with the Cavaliers over the last two seasons. He also appeared in 25 games (23 starts) with the Cleveland Charge over the last two seasons."
    ],
    "original_first_available_at": null,
    "actual_capture": "Nov19 receipt retained; not source-declaredNov18 date"
  },
