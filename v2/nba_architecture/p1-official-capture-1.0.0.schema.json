{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P1 official capture receipt 1.0.0",
  "description": "Structural only. p1_evidence validates raw source bytes, complete revision chain, final periods and player reconciliation. URL/hash consistency is not independent authentication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "url",
    "raw_sha256",
    "retrieved_at",
    "revision",
    "supersedes_receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "nba-p1-prior-game-evidence/1.0.0"
    },
    "url": {
      "type": "string",
      "pattern": "^https://cdn\\.nba\\.com/static/json/liveData/boxscore/boxscore_[0-9]{10}\\.json$"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
